---
import { ui, PHONE_HREF, EMAIL, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const f = ui[lang].footer;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-col">
      <h3>{f.title}</h3>
      <p>{f.about}</p>
    </div>

    <div class="footer-col">
      <h4>{f.navTitle}</h4>
      {f.nav.map((l) => <a href={l.href}>{l.label}</a>)}
    </div>

    <div class="footer-col">
      <h4>{f.contactTitle}</h4>
      <div class="footer-location">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11z"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"/>
          <circle cx="12" cy="10" r="2.5"
                  stroke="currentColor"
                  stroke-width="1.8"/>
        </svg>
        <div>
          <p>{f.address}</p>
        </div>
      </div>
      <p class="footer-contact-line">{f.phoneLabel}: <a href={PHONE_HREF}>{ui[lang].phone}</a></p>
      <p class="footer-contact-line">{f.emailLabel}: <a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
      <p class="footer-contact-line">{f.hours}</p>
    </div>
  </div>

  <div class="footer-bottom">
    <p class="footer-legal">{f.legal} · <a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
    <p class="footer-legal"><a href={f.privacy.href} hreflang={f.privacy.hreflang}>{f.privacy.label}</a></p>
    <p>© {year} {f.copyright}</p>
  </div>
</footer>
