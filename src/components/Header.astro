---
import { ui, languages, PHONE_HREF, type Lang } from '../i18n/ui';
import { languageLinks } from '../data/routes';

interface Props {
  lang: Lang;
  path: string;
}
const { lang, path } = Astro.props;
const t = ui[lang];
const links = languageLinks(path, lang);
const current = languages.find((l) => l.code === lang)!;

// Same rule as the old site: exact match, or a section prefix (never for home).
const isHome = (href: string) => /^\/(bg|en|ru)$/.test(href);
const active = t.nav
  .filter((l) => path === l.href || (!isHome(l.href) && path.startsWith(l.href + '/')))
  .sort((a, b) => b.href.length - a.href.length)[0]?.href;
---
<header class="main-header">
  <nav class="nav-wrapper">
    <div class="logo-area">
      <a href={`/${lang}`} class="logo-link">
        <img src={t.logo.src} alt={t.logo.alt} width="420" height="88" />
      </a>
    </div>

    <div class="nav-floating">
      <div class="nav-container">
        <span class="nav-indicator"></span>
        {t.nav.map((l) => <a href={l.href} class:list={['nav-link', { active: l.href === active }]}>{l.label}</a>)}
      </div>
    </div>

    <div class="right-area">
      <a href={PHONE_HREF} class="phone">
        <svg viewBox="0 0 24 24" class="phone-icon" aria-hidden="true">
          <path
            d="M21 16.5v3a2 2 0 0 1-2.2 2
    19.8 19.8 0 0 1-8.6-3.1
    19.5 19.5 0 0 1-6-6
    19.8 19.8 0 0 1-3.1-8.7A2 2 0 0 1 3.1 1.5h3a2 2 0 0 1 2 1.7
    12.7 12.7 0 0 0 .7 2.8
    2 2 0 0 1-.4 2.1L7 9.9a16 16 0 0 0 6 6l1.8-1.4a2 2 0 0 1 2.1-.4
    12.7 12.7 0 0 0 2.8.7A2 2 0 0 1 21 16.5z"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            fill="none"
          />
        </svg>
        {t.phone}
      </a>

      <a href={t.cta.href} class="cta-button">{t.cta.label}</a>

      <div class="lang-selector" id="langSelector" data-selected={lang}>
        <button
          class="lang-btn"
          id="langToggle"
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-label={t.chooseLanguage}
          type="button"
        >
          <img class="lang-flag" id="langTriggerFlag" alt="" width="16" height="12" src={current.flagSrc} />
          <span class="lang-code" id="langTriggerCode">{lang.toUpperCase()}</span>
          <span class="chev" aria-hidden="true">▾</span>
        </button>
        <ul class="lang-list" id="langList" role="listbox" tabindex="-1" aria-labelledby="langToggle">
          {languages.map((l) => (
            <li role="option" data-lang={l.code} data-flag={l.flag} data-href={links[l.code]}
                aria-selected={l.code === lang ? 'true' : 'false'} tabindex="0">
              <img class="lang-flag" alt={l.name} width="16" height="12" src={l.flagSrc} />
              <span class="lang-name">{l.name}</span>
            </li>
          ))}
        </ul>
      </div>

      <button class="hamburger" id="menuToggle" type="button" aria-label={t.openMenu}>
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </nav>

  <div class="mobile-menu" id="mobileMenu">
    {t.mobileNav.map((l) => <a href={l.href}>{l.label}</a>)}

    <div class="mobile-lang-row">
      {languages.map((l) => (
        <a href={links[l.code]} class:list={['mobile-lang', { 'is-active': l.code === lang }]} data-lang={l.code} data-flag={l.flag}>
          <img class="lang-flag" alt={l.name} width="16" height="12" src={l.flagSrc} />
          <span>{l.code.toUpperCase()}</span>
        </a>
      ))}
    </div>
  </div>
</header>
