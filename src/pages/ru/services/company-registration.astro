---
import Layout from '../../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://mehovconsult.com/ru/services/company-registration",
      "url": "https://mehovconsult.com/ru/services/company-registration",
      "name": "Регистрация фирмы в Болгарии для иностранцев",
      "description": "Как иностранцу открыть ЕООД или ООД в Болгарии в 2026 году: документы, адрес, капитал от 1 €, регистрация по доверенности, налоги и ВНЖ.",
      "inLanguage": "ru",
      "isPartOf": {
        "@type": "WebSite",
        "name": "Мехов Консулт",
        "url": "https://mehovconsult.com/ru"
      },
      "about": {
        "@id": "https://mehovconsult.com/#organization"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Может ли гражданин страны вне ЕС владеть и управлять болгарской фирмой?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да. Гражданство не ограничивает право быть собственником и управляющим ЕООД или ООД. Болгарский совладелец или болгарский управляющий не требуется."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли зарегистрировать фирму удалённо?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "В большинстве случаев – да, по нотариальной доверенности с апостилем и заверенным переводом. Для открытия счёта банк может попросить собственника прийти один раз лично."
          }
        },
        {
          "@type": "Question",
          "name": "Какие налоги платит фирма в Болгарии?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Корпоративный налог – 10%. Дивиденды физическим лицам облагаются налогом 5%. НДС – 20%; регистрация по НДС обязательна, когда облагаемый оборот за календарный год превышает 51 130 €."
          }
        },
        {
          "@type": "Question",
          "name": "Даёт ли фирма право жить в Болгарии?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Сама по себе – нет. Владеть фирмой и управлять ею из-за границы можно без вида на жительство, но для проживания в Болгарии он нужен. Условия зависят от вашей ситуации – Дойчин Мехов объяснит их при разговоре."
          }
        }
      ]
    }
  ]
};
---
<Layout lang="ru" path="/ru/services/company-registration" title={"Регистрация фирмы в Болгарии для иностранцев | Мехов Консулт"} description={"Как иностранцу открыть ЕООД или ООД в Болгарии в 2026 году: документы, адрес, капитал от 1 €, регистрация по доверенности, налоги и ВНЖ."} ogTitle={"Регистрация фирмы в Болгарии для иностранцев"} schema={schema}>
<style is:inline>
/* landing pages (VAMIBEX 19.10.2026) */
.mc-landing { color: #1f2937; line-height: 1.7; }
.mc-landing .lp-hero { background: #111827; color: #fff; padding: 64px 20px 56px; }
.mc-landing .lp-wrap { max-width: 980px; margin: 0 auto; }
.mc-landing .lp-hero h1 { font-size: 2.3rem; line-height: 1.2; margin: 0 0 16px; color: #fff; }
.mc-landing .lp-hero p { font-size: 1.1rem; color: #e5e7eb; margin: 0 0 24px; max-width: 760px; }
.mc-landing .lp-actions { display: flex; flex-wrap: wrap; gap: 12px; }
.mc-landing .lp-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 24px; border-radius: 10px; font-weight: 700; text-decoration: none; }
.mc-landing .lp-btn--main { background: #d00000; color: #fff; }
.mc-landing .lp-btn--ghost { border: 2px solid #fff; color: #fff; }
.mc-landing .lp-trust { list-style: none; display: flex; flex-wrap: wrap; gap: 8px 20px; padding: 0; margin: 18px 0 0; font-weight: 600; }
.mc-landing .lp-trust li::before { content: "✓"; margin-right: 6px; color: #22c55e; font-weight: 800; }
.mc-landing .lp-sec { padding: 48px 20px 8px; }
.mc-landing .lp-sec h2 { font-size: 1.6rem; margin: 0 0 16px; color: #111827; }
.mc-landing .lp-sec h3 { font-size: 1.1rem; margin: 22px 0 6px; color: #111827; }
.mc-landing .lp-list { padding-left: 22px; }
.mc-landing .lp-list li { margin: 0 0 8px; }
.mc-landing .lp-steps { counter-reset: s; list-style: none; padding: 0; display: grid; gap: 14px; }
.mc-landing .lp-steps li { counter-increment: s; position: relative; padding: 14px 16px 14px 60px; background: #f9fafb; border-radius: 12px; }
.mc-landing .lp-steps li::before { content: counter(s); position: absolute; left: 16px; top: 14px; width: 30px; height: 30px; border-radius: 50%; background: #d00000; color: #fff; font-weight: 800; display: flex; align-items: center; justify-content: center; }
.mc-landing .lp-related a { color: #d00000; }
.mc-landing .lp-cta { margin: 48px 20px 64px; padding: 32px 24px; background: #fef2f2; border-radius: 16px; text-align: center; }
.mc-landing .lp-cta h2 { margin: 0 0 10px; font-size: 1.5rem; color: #111827; }
.mc-landing .lp-cta p { margin: 0 0 18px; }
.mc-landing .lp-cta .lp-btn--ghost { border-color: #d00000; color: #d00000; }
.mc-landing .lp-cta .lp-actions { justify-content: center; }
@media (max-width: 600px) {
  .mc-landing .lp-hero { padding: 44px 16px 40px; }
  .mc-landing .lp-hero h1 { font-size: 1.8rem; }
  .mc-landing .lp-btn { width: 100%; }
}
</style>
<style is:inline>
/* RU cards (VAMIBEX 19.10.2026) */
.mc-landing .lp-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; }
.mc-landing .lp-card { display: block; padding: 22px; border: 1px solid #e5e7eb; border-radius: 14px; text-decoration: none; color: #1f2937; background: #fff; }
.mc-landing .lp-card:hover { border-color: #d00000; }
.mc-landing .lp-card strong { display: block; color: #d00000; font-size: 1.05rem; margin: 0 0 6px; }
</style>
<main class="mc-landing">
<section class="lp-hero"><div class="lp-wrap">
<h1>Регистрация фирмы в Болгарии для иностранцев</h1>
<p>Болгарское законодательство позволяет иностранцам – из ЕС и из других стран – быть собственниками и управляющими фирмы. Мы готовим документы, регистрируем фирму и ведём её бухгалтерию с первого дня.</p>
<div class="lp-actions"><a class="lp-btn lp-btn--main" href="tel:+359879884488">Позвонить: +359 879 88 44 88</a><a class="lp-btn lp-btn--ghost" href="/ru/contact#contact-form">Получить бесплатное предложение</a></div>
<!-- mc-hero-call (VAMIBEX 20.10.2026) -->
<p class="mc-hero-call" style="margin: 14px 0 0; font-size: 0.95rem; line-height: 1.5; opacity: 0.92; max-width: 640px;">Свяжитесь с Дойчином Меховым. Расскажите коротко, что вам нужно, – он объяснит дальнейшие шаги, и вы получите предложение.</p>
<!-- mc-hero-price (VAMIBEX 20.10.2026) -->
<p class="mc-hero-price" style="margin: 10px 0 0; font-size: 1rem; line-height: 1.5; font-weight: 700; max-width: 640px;">Регистрация фирмы – 179 €</p>
<ul class="lp-trust"><li>Вы говорите напрямую с Дойчином Меховым</li><li>Более 25 лет опыта</li><li>Говорим по-русски</li></ul>
</div></section>
<section class="lp-sec"><div class="lp-wrap">
<h2>Что понадобится</h2>
<ul class="lp-list"><li>Действующий паспорт каждого собственника и управляющего.</li><li>Адрес управления фирмы в Болгарии (личный адрес в Болгарии не нужен).</li><li>Документы, подписанные за границей (доверенность, образец подписи, декларации), – с апостилем или легализацией и заверенным переводом на болгарский.</li><li>Минимальный капитал – 1 €, вносится на счёт в болгарском банке.</li></ul>
</div></section>
<section class="lp-sec"><div class="lp-wrap">
<h2>Как проходит регистрация</h2>
<ol class="lp-steps"><li>Обсуждаем форму фирмы (ЕООД или ООД), вид деятельности и адрес.</li><li>Готовим документы и говорим, что нужно подписать и заверить.</li><li>Вы подписываете в Болгарии или за границей по нотариальной доверенности; банк может попросить собственника прийти один раз лично.</li><li>Подаём документы в Торговый реестр и при необходимости регистрируем фирму по НДС.</li></ol>
</div></section>
<section class="lp-sec lp-faq"><div class="lp-wrap">
<h2>Частые вопросы</h2>
<h3>Может ли гражданин страны вне ЕС владеть и управлять болгарской фирмой?</h3>
<p>Да. Гражданство не ограничивает право быть собственником и управляющим ЕООД или ООД. Болгарский совладелец или болгарский управляющий не требуется.</p>
<h3>Можно ли зарегистрировать фирму удалённо?</h3>
<p>В большинстве случаев – да, по нотариальной доверенности с апостилем и заверенным переводом. Для открытия счёта банк может попросить собственника прийти один раз лично.</p>
<h3>Какие налоги платит фирма в Болгарии?</h3>
<p>Корпоративный налог – 10%. Дивиденды физическим лицам облагаются налогом 5%. НДС – 20%; регистрация по НДС обязательна, когда облагаемый оборот за календарный год превышает 51 130 €.</p>
<h3>Даёт ли фирма право жить в Болгарии?</h3>
<p>Сама по себе – нет. Владеть фирмой и управлять ею из-за границы можно без вида на жительство, но для проживания в Болгарии он нужен. Условия зависят от вашей ситуации – Дойчин Мехов объяснит их при разговоре.</p>
</div></section>
<section class="lp-cta"><div class="lp-wrap">
<h2>Планируете открыть фирму в Болгарии?</h2>
<p>Напишите нам – ответим с конкретным предложением. Офис в Софии, жк Дырвеница; работаем и удалённо.</p>
<div class="lp-actions"><a class="lp-btn lp-btn--main" href="tel:+359879884488">Позвонить: +359 879 88 44 88</a><a class="lp-btn lp-btn--ghost" href="/ru/contact#contact-form">Получить бесплатное предложение</a></div>
</div></section>
</main> 
<!-- ===== FOOTER (VAMIBEX 18.10.2026) ===== -->
<!-- www -> non-www (VAMIBEX 12.11.2026; временно, докато няма 301 на сървъра) -->
</Layout>
