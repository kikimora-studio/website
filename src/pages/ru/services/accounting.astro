---
import Layout from '../../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://mehovconsult.com/ru/services/accounting",
      "url": "https://mehovconsult.com/ru/services/accounting",
      "name": "Бухгалтерское обслуживание в Болгарии | Мехов Консулт",
      "description": "Ежемесячная бухгалтерия для фирм в Болгарии: НДС и декларации до 14-го числа, зарплаты и взносы, годовой отчёт и налоговая декларация. На русском языке.",
      "inLanguage": "ru",
      "isPartOf": {
        "@type": "WebSite",
        "name": "Мехов Консулт",
        "url": "https://mehovconsult.com/ru"
      },
      "about": {
        "@id": "https://mehovconsult.com/#organization"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "До какого числа подаётся декларация по НДС?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Справка-декларация по НДС подаётся ежемесячно до 14-го числа следующего месяца – даже если продаж не было."
          }
        },
        {
          "@type": "Question",
          "name": "Когда сдаётся годовая отчётность за 2025 год?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Годовая налоговая декларация фирмы и уплата корпоративного налога – до 30 июня 2026 г. Годовой финансовый отчёт публикуется в Торговом реестре до 30 сентября 2026 г."
          }
        },
        {
          "@type": "Question",
          "name": "Нужен ли бухгалтер, если у фирмы нет оборота?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да, обязанности остаются: например, фирма, зарегистрированная по НДС, ежемесячно подаёт декларацию, а фирма без деятельности подаёт декларацию об отсутствии деятельности в Торговый реестр до 30 июня."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли сменить бухгалтера в середине года?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да. Удобнее всего – после подачи ежемесячных деклараций. Мы подскажем, какие документы запросить у прежнего бухгалтера."
          }
        }
      ]
    }
  ]
};
---
<Layout lang="ru" path="/ru/services/accounting" title={"Бухгалтерское обслуживание в Болгарии | Мехов Консулт"} description={"Ежемесячная бухгалтерия для фирм в Болгарии: НДС и декларации до 14-го числа, зарплаты и взносы, годовой отчёт и налоговая декларация. На русском языке."} schema={schema}>
<style is:inline>
/* landing pages (VAMIBEX 19.10.2026) */
.mc-landing { color: #1f2937; line-height: 1.7; }
.mc-landing .lp-hero { background: #111827; color: #fff; padding: 64px 20px 56px; }
.mc-landing .lp-wrap { max-width: 980px; margin: 0 auto; }
.mc-landing .lp-hero h1 { font-size: 2.3rem; line-height: 1.2; margin: 0 0 16px; color: #fff; }
.mc-landing .lp-hero p { font-size: 1.1rem; color: #e5e7eb; margin: 0 0 24px; max-width: 760px; }
.mc-landing .lp-actions { display: flex; flex-wrap: wrap; gap: 12px; }
.mc-landing .lp-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 24px; border-radius: 10px; font-weight: 700; text-decoration: none; }
.mc-landing .lp-btn--main { background: #d00000; color: #fff; }
.mc-landing .lp-btn--ghost { border: 2px solid #fff; color: #fff; }
.mc-landing .lp-trust { list-style: none; display: flex; flex-wrap: wrap; gap: 8px 20px; padding: 0; margin: 18px 0 0; font-weight: 600; }
.mc-landing .lp-trust li::before { content: "✓"; margin-right: 6px; color: #22c55e; font-weight: 800; }
.mc-landing .lp-sec { padding: 48px 20px 8px; }
.mc-landing .lp-sec h2 { font-size: 1.6rem; margin: 0 0 16px; color: #111827; }
.mc-landing .lp-sec h3 { font-size: 1.1rem; margin: 22px 0 6px; color: #111827; }
.mc-landing .lp-list { padding-left: 22px; }
.mc-landing .lp-list li { margin: 0 0 8px; }
.mc-landing .lp-steps { counter-reset: s; list-style: none; padding: 0; display: grid; gap: 14px; }
.mc-landing .lp-steps li { counter-increment: s; position: relative; padding: 14px 16px 14px 60px; background: #f9fafb; border-radius: 12px; }
.mc-landing .lp-steps li::before { content: counter(s); position: absolute; left: 16px; top: 14px; width: 30px; height: 30px; border-radius: 50%; background: #d00000; color: #fff; font-weight: 800; display: flex; align-items: center; justify-content: center; }
.mc-landing .lp-related a { color: #d00000; }
.mc-landing .lp-cta { margin: 48px 20px 64px; padding: 32px 24px; background: #fef2f2; border-radius: 16px; text-align: center; }
.mc-landing .lp-cta h2 { margin: 0 0 10px; font-size: 1.5rem; color: #111827; }
.mc-landing .lp-cta p { margin: 0 0 18px; }
.mc-landing .lp-cta .lp-btn--ghost { border-color: #d00000; color: #d00000; }
.mc-landing .lp-cta .lp-actions { justify-content: center; }
@media (max-width: 600px) {
  .mc-landing .lp-hero { padding: 44px 16px 40px; }
  .mc-landing .lp-hero h1 { font-size: 1.8rem; }
  .mc-landing .lp-btn { width: 100%; }
}
</style>
<main class="mc-landing">
<section class="lp-hero"><div class="lp-wrap">
<h1>Бухгалтерское обслуживание в Болгарии</h1>
<p>Ведём бухгалтерию ЕООД и ООД в Болгарии: от первичных документов до годового отчёта. Объясняем на русском, что, когда и почему нужно сдать, и следим за сроками вместо вас.</p>
<div class="lp-actions"><a class="lp-btn lp-btn--main" href="tel:+359879884488">Позвонить: +359 879 88 44 88</a><a class="lp-btn lp-btn--ghost" href="/ru/contact#contact-form">Получить бесплатное предложение</a></div>
<!-- mc-hero-call (VAMIBEX 20.10.2026) -->
<p class="mc-hero-call" style="margin: 14px 0 0; font-size: 0.95rem; line-height: 1.5; opacity: 0.92; max-width: 640px;">Свяжитесь с Дойчином Меховым. Расскажите коротко, что вам нужно, – он объяснит дальнейшие шаги, и вы получите предложение.</p>
<!-- mc-hero-price (VAMIBEX 20.10.2026) -->
<p class="mc-hero-price" style="margin: 10px 0 0; font-size: 1rem; line-height: 1.5; font-weight: 700; max-width: 640px;">Бухгалтерское обслуживание – от 120 € в месяц</p>
<ul class="lp-trust"><li>Вы говорите напрямую с Дойчином Меховым</li><li>Более 25 лет опыта</li><li>Говорим по-русски</li></ul>
</div></section>
<section class="lp-sec"><div class="lp-wrap">
<h2>Что входит в обслуживание</h2>
<ul class="lp-list"><li>Ежемесячная бухгалтерия: обработка счетов, банковских выписок и кассы.</li><li>НДС: регистрация, ежемесячные справки-декларации и журналы покупок и продаж до 14-го числа.</li><li>Зарплаты и взносы: трудовые договоры, уведомления в НАП, декларации обр. 1 и обр. 6 до 25-го числа.</li><li>Годовой отчёт: годовая налоговая декларация до 30 июня и публикация годового финансового отчёта в Торговом реестре до 30 сентября.</li><li>Общение с НАП и НОИ от вашего имени.</li></ul>
</div></section>
<section class="lp-sec"><div class="lp-wrap">
<h2>Как мы работаем</h2>
<ol class="lp-steps"><li>Вы рассказываете о фирме: деятельность, количество документов, сотрудники, регистрация по НДС.</li><li>Мы присылаем предложение.</li><li>Вы отправляете документы каждый месяц – по электронной почте или лично в офисе.</li><li>Мы сдаём декларации в срок и сообщаем вам суммы к оплате.</li></ol>
</div></section>
<section class="lp-sec lp-faq"><div class="lp-wrap">
<h2>Частые вопросы</h2>
<h3>До какого числа подаётся декларация по НДС?</h3>
<p>Справка-декларация по НДС подаётся ежемесячно до 14-го числа следующего месяца – даже если продаж не было.</p>
<h3>Когда сдаётся годовая отчётность за 2025 год?</h3>
<p>Годовая налоговая декларация фирмы и уплата корпоративного налога – до 30 июня 2026 г. Годовой финансовый отчёт публикуется в Торговом реестре до 30 сентября 2026 г.</p>
<h3>Нужен ли бухгалтер, если у фирмы нет оборота?</h3>
<p>Да, обязанности остаются: например, фирма, зарегистрированная по НДС, ежемесячно подаёт декларацию, а фирма без деятельности подаёт декларацию об отсутствии деятельности в Торговый реестр до 30 июня.</p>
<h3>Можно ли сменить бухгалтера в середине года?</h3>
<p>Да. Удобнее всего – после подачи ежемесячных деклараций. Мы подскажем, какие документы запросить у прежнего бухгалтера.</p>
</div></section>
<section class="lp-cta"><div class="lp-wrap">
<h2>Нужен бухгалтер для вашей фирмы в Болгарии?</h2>
<p>Напишите нам – ответим с конкретным предложением. Офис в Софии, жк Дырвеница; работаем и удалённо.</p>
<div class="lp-actions"><a class="lp-btn lp-btn--main" href="tel:+359879884488">Позвонить: +359 879 88 44 88</a><a class="lp-btn lp-btn--ghost" href="/ru/contact#contact-form">Получить бесплатное предложение</a></div>
</div></section>
</main> 
<!-- ===== FOOTER (VAMIBEX 18.10.2026) ===== -->
<!-- www -> non-www (VAMIBEX 12.11.2026; временно, докато няма 301 на сървъра) -->
</Layout>
