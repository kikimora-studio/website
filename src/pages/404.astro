---
import Layout from '../layouts/Layout.astro';
import { ui } from '../i18n/ui';

const t = ui.bg.notFound;
---
<Layout lang="bg" path="/404" title={`${t.title} | Мехов Консулт`} description={t.text} noindex>
  <main class="mc-post">
    <header class="post-hero">
      <div class="post-hero__wrap container">
        <h1>{t.title}</h1>
        <p class="post-lead">{t.text}</p>
        <a class="btn btn-orange" href="/bg">{t.home}</a>{' '}
        <a class="btn btn-outline" href="/bg/contact">Контакти</a>
        <p><a href="/en">{ui.en.notFound.home} (English)</a></p>
      </div>
    </header>
  </main>
</Layout>
