---
import Layout from '../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://mehovconsult.com/en",
      "name": "Accounting Firm in Sofia, Bulgaria | Mehov Consult",
      "description": "Accounting firm in Sofia, Bulgaria: accounting services for companies, company registration (EOOD/OOD), tax consulting. A personal accountant and clear terms.",
      "url": "https://mehovconsult.com/en",
      "inLanguage": "en",
      "isPartOf": {
        "@type": "WebSite",
        "name": "Мехов Консулт",
        "url": "https://mehovconsult.com/bg"
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://mehovconsult.com/en#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What accounting services do you offer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Full monthly accounting, financial statements, payroll (salaries and social security), VAT returns and tax planning."
          }
        },
        {
          "@type": "Question",
          "name": "How much does company registration cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Company registration is 179 € — including the state fee and all documentation through to entry in the Commercial Register. Notary fees and other costs are paid separately."
          }
        },
        {
          "@type": "Question",
          "name": "Do you work with companies outside Sofia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. We also work remotely — communication and document exchange happen online, so it does not matter where your company is based."
          }
        },
        {
          "@type": "Question",
          "name": "How can I legally reduce my tax costs?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Through proper tax planning and optimization tailored to your activity. We analyse your business structure and propose sustainable, lawful solutions."
          }
        }
      ]
    }
  ]
};
---
<Layout lang="en" path="/en" title={"Accounting Firm in Sofia, Bulgaria | Mehov Consult"} description={"Accounting firm in Sofia, Bulgaria: accounting services for companies, company registration (EOOD/OOD), tax consulting. A personal accountant and clear terms."} schema={schema}>
<main class="mc-home">
  <style is:inline>
    .mc-home {
      --brand: #d00000;
      --brand-2: #4d0000;
      --red: #d00000;
      --red-dark: #b91c1c;
      --text: #15181b;
      --muted: #5b6672;
      --surface: #ffffff;
      --bg: #fefefe;
      --border: rgba(0, 0, 0, 0.06);
      --radius: 22px;
      --shadow: 0 20px 60px rgba(0, 0, 0, 0.12);
      --shadow-soft: 0 12px 30px rgba(0, 0, 0, 0.08);
      font-family: "PT Sans", system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
      color: var(--text);
      background: var(--bg);
      line-height: 1.6;
      max-width: 100%;
    }
    .mc-home * { box-sizing: border-box; }
    .mc-home .container {
      width: 100%;
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 20px;
    }
    .mc-home .section__title {
      font-weight: 900;
      font-size: clamp(1.6rem, 4vw, 2rem);
      margin: 0 0 40px;
      text-align: center;
      color: var(--brand-2);
    }
    /* ===== HERO ===== */
    .mc-home .mc-hero {
      position: relative;
      min-height: 60vh;
      padding: 120px 20px 80px;
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      justify-content: center !important;
      text-align: center !important;
      color: #fff;
      background-image:
        linear-gradient(rgba(0, 0, 0, 0.45), rgba(0, 0, 0, 0.2)),
        url('/images/hero.webp');
      background-size: cover;
      background-position: center;
      overflow: hidden;
    }
    .mc-home .mc-hero__bg {
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle at 25% 30%, rgba(208, 0, 0, 0.15), transparent 60%),
        radial-gradient(circle at 75% 70%, rgba(31, 125, 197, 0.15), transparent 55%);
      z-index: 0;
      animation: mcFloatBg 12s ease-in-out infinite alternate;
      pointer-events: none;
    }
    @keyframes mcFloatBg {
      from { transform: translateY(0); }
      to { transform: translateY(20px); }
    }
    .mc-home .mc-hero__wrap {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 760px;
      margin: 0 auto;
      display: block !important;
      text-align: center !important;
    }
    .mc-home .mc-hero__content {
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      justify-content: center !important;
      gap: 0;
      width: 100%;
      text-align: center !important;
    }
    .mc-home .mc-hero__title {
      display: block;
      width: 100%;
      font-size: clamp(2.2rem, 6vw, 3.2rem) !important;
      font-weight: 800 !important;
      margin: 0 0 16px !important;
      line-height: 1.15 !important;
      color: #d00000 !important;
      text-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
    }
    .mc-home .mc-hero__sub {
      display: block;
      width: 100%;
      font-size: clamp(1.05rem, 2.5vw, 1.25rem) !important;
      color: #ffffff !important;
      margin: 0 0 28px !important;
      max-width: 560px;
      text-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
    }
    .mc-home .mc-hero__actions {
      display: flex !important;
      flex-direction: row !important;
      flex-wrap: wrap;
      gap: 16px;
      justify-content: center !important;
      align-items: center !important;
      width: 100%;
      margin-top: 4px;
    }
    .mc-home .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 14px 28px;
      border-radius: 999px;
      font-weight: 700;
      font-size: 0.95rem;
      text-decoration: none;
      border: none;
      cursor: pointer;
      font-family: inherit;
      transition: transform 0.3s ease, box-shadow 0.3s ease, background 0.3s ease, color 0.3s ease;
    }
    .mc-home .btn-orange {
      background: var(--brand);
      color: #fff;
      box-shadow: 0 15px 40px rgba(208, 0, 0, 0.3);
    }
    .mc-home .btn-orange:hover {
      transform: translateY(-3px);
      background: var(--red-dark);
    }
    .mc-home .mc-hero .mc-btn-outline {
      background: #fff !important;
      color: #d00000 !important;
      border: 2px solid #d00000 !important;
    }
    .mc-home .mc-hero .mc-btn-outline:hover {
      background: #d00000 !important;
      color: #fff !important;
    }
    /* ===== SERVICES ===== */
    .mc-home .services-premium {
      padding: 90px 20px;
      background: #f9fafb;
    }
    .mc-home .services-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 40px;
      margin-top: 10px;
    }
    @media (min-width: 768px) {
      .mc-home .services-grid { grid-template-columns: repeat(3, 1fr); }
    }
    .mc-home .service-item {
      background: #fff;
      padding: 50px 35px;
      border-radius: var(--radius);
      text-align: center;
      transition: all 0.35s ease;
      border: 1px solid var(--border);
    }
    .mc-home .service-item:hover {
      transform: translateY(-8px);
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.08);
      border-color: rgba(208, 0, 0, 0.15);
    }
    .mc-home .service-icon {
      width: 70px;
      height: 70px;
      margin: 0 auto 25px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 18px;
      background: rgba(208, 0, 0, 0.06);
      color: var(--red-dark);
      transition: all 0.3s ease;
    }
    .mc-home .service-item:hover .service-icon {
      background: var(--red-dark);
      color: #fff;
    }
    .mc-home .service-icon svg { width: 32px; height: 32px; }
    .mc-home .service-link { text-decoration: none; color: inherit; }
    .mc-home .service-item h4 {
      font-size: 1.2rem;
      font-weight: 800;
      margin: 0 0 14px;
      color: #111827;
    }
    .mc-home .service-item p {
      color: var(--muted);
      font-size: 0.98rem;
      line-height: 1.6;
      margin: 0;
    }
    /* ===== STATS ===== */
    .mc-home .mc-stats {
      padding: 90px 20px;
      background: #ffffff !important;
    }
    .mc-home .mc-stats__grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 28px;
      text-align: center;
    }
    @media (min-width: 768px) {
      .mc-home .mc-stats__grid { grid-template-columns: repeat(4, 1fr); }
    }
    .mc-home .mc-stats__card {
      padding: 36px 20px;
      border-radius: var(--radius);
      background: #ffffff !important;
      box-shadow: var(--shadow-soft);
      border: 1px solid rgba(0, 0, 0, 0.06);
      transition: all 0.3s ease;
    }
    .mc-home .mc-stats__card:hover {
      transform: translateY(-6px);
      box-shadow: var(--shadow);
    }
    .mc-home .mc-stats__icon {
      width: 70px;
      height: 70px;
      margin: 0 auto 16px;
      border-radius: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(208, 0, 0, 0.08);
      color: #d00000 !important;
      transition: 0.3s ease;
    }
    .mc-home .mc-stats__icon svg { width: 30px; height: 30px; }
    .mc-home .mc-stats__card:hover .mc-stats__icon {
      background: #d00000;
      color: #fff !important;
    }
    .mc-home .mc-stats__num {
      display: block !important;
      visibility: visible !important;
      opacity: 1 !important;
      font-size: 2rem !important;
      font-weight: 900 !important;
      color: #d00000 !important;
      margin: 0 0 8px !important;
      line-height: 1.2 !important;
    }
    .mc-home .mc-stats__num::after {
      content: "+";
      color: #d00000 !important;
    }
    .mc-home .mc-stats__label {
      display: block !important;
      visibility: visible !important;
      opacity: 1 !important;
      color: #5b6672 !important;
      margin: 0 !important;
      font-weight: 600 !important;
      font-size: 0.95rem !important;
    }
    /* ===== REVIEWS ===== */
    .mc-home .reviews-section {
      padding: 90px 20px;
      background: #f9fafb;
      text-align: center;
    }
    .mc-home .reviews-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 30px;
      max-width: 1100px;
      margin: 0 auto;
    }
    @media (min-width: 768px) {
      .mc-home .reviews-grid { grid-template-columns: repeat(2, 1fr); }
    }
    .mc-home .review-card {
      background: var(--surface);
      padding: 45px;
      border-radius: var(--radius);
      box-shadow: var(--shadow-soft);
      text-align: center;
      transition: all 0.3s ease;
    }
    .mc-home .review-card:hover { box-shadow: var(--shadow); }
    .mc-home .review-avatar {
      width: 70px;
      height: 70px;
      border-radius: 50%;
      object-fit: cover;
      margin: 0 auto 15px;
      display: block;
      border: 3px solid #fee2e2;
    }
    .mc-home .review-stars {
      display: flex;
      justify-content: center;
      gap: 5px;
      color: #f4b400;
      margin-bottom: 15px;
    }
    .mc-home .review-stars svg { width: 18px; height: 18px; }
    .mc-home .review-text {
      font-size: 1.05rem;
      line-height: 1.7;
      color: var(--text);
      margin: 0 0 20px;
    }
    .mc-home .review-author {
      font-weight: 700;
      color: var(--brand);
      font-size: 0.95rem;
    }
    /* ===== FINAL CTA ===== */
    .mc-home .final {
      padding: 60px 20px;
      text-align: center;
      background: linear-gradient(180deg, rgba(250, 250, 250, 0.95), #fff);
    }
    .mc-home .final h2 {
      font-weight: 900;
      font-size: clamp(2rem, 6vw, 3rem);
      margin: 0 0 8px;
      color: var(--brand-2);
    }
    .mc-home .final h2 span { color: var(--brand); }
    .mc-home .final h3 {
      font-weight: 500;
      font-size: 1.25rem;
      color: var(--brand);
      margin: 0 0 28px;
    }
    /* ===== FAQ ===== */
    .mc-home .faq-section {
      padding: 80px 20px 100px;
      background: #fff;
    }
    .mc-home .faq-item {
      max-width: 800px;
      margin: 0 auto 20px;
      border-radius: 18px;
      overflow: hidden;
      box-shadow: var(--shadow-soft);
      border: 1px solid var(--border);
    }
    .mc-home .faq-question {
      width: 100%;
      background: #fff;
      border: none;
      padding: 20px 25px;
      text-align: left;
      font-weight: 700;
      font-size: 1rem;
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      font-family: inherit;
      color: var(--text);
    }
    .mc-home .faq-question span {
      color: var(--brand);
      font-size: 20px;
      transition: transform 0.3s ease;
      flex-shrink: 0;
    }
    .mc-home .faq-answer {
      max-height: 0;
      overflow: hidden;
      background: #fafafa;
      padding: 0 25px;
      transition: all 0.4s ease;
      color: var(--muted);
      line-height: 1.7;
    }
    .mc-home .faq-item.active .faq-answer {
      max-height: 260px;
      padding: 0 25px 20px;
    }
    .mc-home .faq-item.active .faq-question span { transform: rotate(45deg); }
    /* ===== MODAL ===== */
    .mc-home .modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.55);
      justify-content: center;
      align-items: flex-start;
      padding: 40px 20px;
      z-index: 99999;
      overflow-y: hidden;
      backdrop-filter: blur(4px);
    }
    .mc-home .modal.show { display: flex; overflow-y: auto; }
    .mc-home .modal-content {
      background: #fff;
      border-radius: 24px;
      padding: 32px;
      max-width: 640px;
      width: 100%;
      position: relative;
      animation: mcFadeInUp 0.4s ease forwards;
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.2);
    }
    @keyframes mcFadeInUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .mc-home .modal-content h2 {
      color: var(--red-dark);
      margin: 0 0 10px;
      font-size: 1.5rem;
      font-weight: 700;
    }
    .mc-home .modal-content > p {
      margin: 0 0 16px;
      color: var(--muted);
    }
    .mc-home #closeModal {
      position: absolute;
      top: 15px;
      right: 20px;
      font-size: 28px;
      font-weight: 700;
      color: #111;
      cursor: pointer;
      line-height: 1;
      background: none;
      border: 0;
      padding: 0;
      z-index: 2;
    }
    .mc-home #closeModal:hover { color: var(--red-dark); }
    .mc-home .modal-form {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      margin-top: 14px;
    }
    .mc-home .modal-form .field-full { grid-column: 1 / -1; }
    .mc-home .modal-form input,
    .mc-home .modal-form textarea {
      border: 1px solid #ddd;
      border-radius: 18px;
      padding: 16px 18px;
      width: 100%;
      font-size: 14px;
      font-family: inherit;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .mc-home .modal-form textarea {
      min-height: 110px;
      resize: vertical;
    }
    .mc-home .modal-form input:focus,
    .mc-home .modal-form textarea:focus {
      outline: none;
      border-color: var(--brand);
      box-shadow: 0 0 0 4px rgba(208, 0, 0, 0.12);
    }
    .mc-home .modal-form .form-verify-block {
      grid-column: 1 / -1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.25rem;
    }
    .mc-home .modal-form .turnstile-modal-widget-wrap {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .mc-home .modal-form .form-security-loading {
      display: flex;
      align-items: center;
      gap: 0.375rem;
      color: #9ca3af;
      font-size: 0.8rem;
    }
    .mc-home .modal-form .form-security-spinner {
      width: 0.875rem;
      height: 0.875rem;
      border: 2px solid #e5e7eb;
      border-top-color: var(--brand);
      border-radius: 50%;
      animation: mcSpin 0.7s linear infinite;
    }
    @keyframes mcSpin { to { transform: rotate(360deg); } }
    .mc-home .modal-form .turnstile-modal-widget {
      display: flex;
      justify-content: center;
      width: 100%;
    }
    .mc-home .modal-form .turnstile-modal-status {
      font-size: 0.8rem;
      text-align: center;
      color: #6b7280;
    }
    .mc-home .modal-form [data-form-result] {
      grid-column: 1 / -1;
      min-height: 1.25rem;
      font-size: 0.95rem;
    }
    .mc-home .modal-form button[type="submit"] {
      grid-column: 1 / -1;
      background: var(--red-dark);
      color: #fff;
      padding: 14px 24px;
      border-radius: 40px;
      font-weight: 600;
      cursor: pointer;
      border: 0;
      font-family: inherit;
      font-size: 1rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }
    .mc-home .modal-form button[type="submit"]:hover:not(:disabled) { background: #991b1b; }
    .mc-home .modal-form button[type="submit"]:disabled { background: #9ca3af; cursor: not-allowed; }
    /* Reveal */
    .mc-home .reveal {
      opacity: 0;
      transform: translateY(28px);
      transition: opacity 0.7s ease, transform 0.7s ease;
    }
    .mc-home .reveal.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
    @media (max-width: 600px) {
      .mc-home .mc-hero { min-height: 55vh; padding: 100px 16px 70px; }
      .mc-home .mc-hero__actions { flex-direction: column !important; width: 100%; }
      .mc-home .mc-hero__actions .btn { width: 100%; max-width: 320px; }
      .mc-home .modal-form { grid-template-columns: 1fr; }
      .mc-home .review-card { padding: 28px 20px; }
      .mc-home .service-item { padding: 36px 24px; }
    }
</style>
  <section class="mc-hero">
    <div class="mc-hero__bg" aria-hidden="true"></div>
    <div class="mc-hero__wrap">
      <div class="mc-hero__content">
        <h1 class="mc-hero__title">Accounting Services in Sofia, Bulgaria</h1>
        <p class="mc-hero__sub">Reliable accounting, company registration and tax advice — with over 25 years of experience. We also work remotely – you can send your documents by email.</p>
        <div class="mc-hero__actions">
          <a href="tel:+359879884488" class="btn btn-orange">Call +359 879 88 44 88</a>
          <a href="/en/contact#contact-form" class="btn mc-btn-outline" data-open-enquiry="">Get a free quote</a>
        </div>
<!-- mc-hero-call (VAMIBEX 20.10.2026) -->
<p class="mc-hero-call" style="margin: 14px 0 0; font-size: 0.95rem; line-height: 1.5; opacity: 0.92; max-width: 640px;">Contact Doychin Mehov. Tell him briefly what you need – he will explain the next steps and you will get a quote.</p>
<!-- mc-hero-price (VAMIBEX 20.10.2026) -->
<p class="mc-hero-price" style="margin: 10px 0 0; font-size: 1rem; line-height: 1.5; font-weight: 700; max-width: 640px;">Accounting from 120 € per month · Company registration 179 € · Consultation from 50 € per hour</p>
