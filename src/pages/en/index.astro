      </div>
    </div>
  </section>
  <section class="services-premium reveal" aria-label="Our Services">
    <div class="container">
      <h2 class="section__title">Our Services</h2>
      <div class="services-grid">
        <div class="service-item">
          <div class="service-icon"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="4" y="2" width="16" height="20" rx="3" stroke="currentColor" stroke-width="1.8"></rect><line x1="8" y1="7" x2="16" y2="7" stroke="currentColor" stroke-width="1.8"></line><circle cx="8" cy="11" r="1" fill="currentColor"></circle><circle cx="12" cy="11" r="1" fill="currentColor"></circle><circle cx="16" cy="11" r="1" fill="currentColor"></circle><circle cx="8" cy="15" r="1" fill="currentColor"></circle><circle cx="12" cy="15" r="1" fill="currentColor"></circle><circle cx="16" cy="15" r="1" fill="currentColor"></circle></svg></div>
          <a href="/en/services/accounting" class="service-link"><h3 style="font-size:1.2rem;font-weight:800;margin:0 0 14px;color:#111827;">Accounting Services</h3></a>
          <p>Full monthly accounting — from day-to-day bookkeeping to annual reports and tax returns.</p>
        </div>
        <div class="service-item">
          <div class="service-icon"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 17l6-6 4 4 7-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path><circle cx="3" cy="17" r="1.5" fill="currentColor"></circle><circle cx="9" cy="11" r="1.5" fill="currentColor"></circle><circle cx="13" cy="15" r="1.5" fill="currentColor"></circle><circle cx="20" cy="8" r="1.5" fill="currentColor"></circle></svg></div>
          <a href="/en/services/consultancy" class="service-link"><h3 style="font-size:1.2rem;font-weight:800;margin:0 0 14px;color:#111827;">Consulting Services</h3></a>
          <p>Tax planning and business advice — clear answers for cost optimization and sustainable growth.</p>
        </div>
        <div class="service-item">
          <div class="service-icon"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2" stroke="currentColor" stroke-width="1.8"></rect><line x1="8" y1="7" x2="8" y2="17" stroke="currentColor" stroke-width="1.5"></line><line x1="12" y1="7" x2="12" y2="17" stroke="currentColor" stroke-width="1.5"></line><line x1="16" y1="7" x2="16" y2="17" stroke="currentColor" stroke-width="1.5"></line></svg></div>
