---
import Layout from '../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://mehovconsult.com/en/contact",
      "name": "Contact – Mehov Consult, Accounting Firm in Sofia",
      "description": "Contact Mehov Consult accounting firm: Sofia 1756, Darvenitsa, Block 48, Entrance V, Office 6. Phone +359 879 88 44 88, Monday–Friday 9:00–17:00.",
      "url": "https://mehovconsult.com/en/contact",
      "inLanguage": "en",
      "isPartOf": {
        "@type": "WebSite",
        "name": "Мехов Консулт",
        "url": "https://mehovconsult.com/bg"
      }
    }
  ]
};
---
<Layout lang="en" path="/en/contact" title={"Contact – Mehov Consult, Accounting Firm in Sofia"} description={"Contact Mehov Consult accounting firm: Sofia 1756, Darvenitsa, Block 48, Entrance V, Office 6. Phone +359 879 88 44 88, Monday–Friday 9:00–17:00."} schema={schema}>
<div class="widget-placeholder-wrap">
<main class="mc-contact-page">
  <style is:inline>
    .mc-contact-page {
      --red: #d00000;
      --text: #1f2937;
      --muted: #6b7280;
      --border: rgba(0, 0, 0, 0.06);
      --shadow: 0 15px 40px rgba(0, 0, 0, 0.08);
      --shadow-soft: 0 8px 24px rgba(0, 0, 0, 0.06);
      --radius: 18px;
      font-family: "PT Sans", "Inter", system-ui, sans-serif;
      color: var(--text);
      background: #f5f7fa;
      line-height: 1.6;
      max-width: 100%;
    }
    .mc-contact-page * { box-sizing: border-box; }
    .mc-contact-page .container {
      width: min(960px, 92%);
      margin: 0 auto;
    }
    .mc-contact-page .container--wide {
      width: min(1100px, 92%);
      margin: 0 auto;
    }
    /* Hero */
    .mc-contact-page .mc-contact-hero {
      position: relative;
      padding: 88px 20px 64px;
      overflow: hidden;
      background:
        radial-gradient(circle at 12% 18%, rgba(208, 0, 0, 0.09), transparent 45%),
        linear-gradient(120deg, #ffffff, #fdf2e9);
    }
    .mc-contact-page .mc-contact-hero__orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(60px);
      pointer-events: none;
      animation: mcContactOrb 14s ease-in-out infinite alternate;
    }
    .mc-contact-page .mc-contact-hero__orb--1 {
      width: 240px; height: 240px;
      background: rgba(208, 0, 0, 0.1);
      top: -40px; left: -40px;
    }
    .mc-contact-page .mc-contact-hero__orb--2 {
      width: 180px; height: 180px;
      background: rgba(255, 200, 150, 0.35);
      bottom: -20px; right: 8%;
      animation-delay: -5s;
    }
    @keyframes mcContactOrb {
      from { transform: translate(0, 0); }
      to { transform: translate(16px, 20px) scale(1.06); }
    }
    .mc-contact-page .mc-contact-hero__wrap {
      position: relative;
      z-index: 1;
      max-width: 720px;
      margin: 0 auto;
      text-align: center;
      animation: mcContactFade 0.85s ease-out both;
    }
    @keyframes mcContactFade {
      from { opacity: 0; transform: translateY(28px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .mc-contact-page .mc-contact-hero__title {
      font-size: clamp(2.2rem, 5vw, 3.2rem) !important;
      color: #d00000 !important;
      font-weight: 800 !important;
      margin: 0 0 14px !important;
      line-height: 1.12 !important;
    }
    .mc-contact-page .mc-contact-hero__sub {
      font-size: clamp(1.05rem, 2.2vw, 1.25rem) !important;
      color: #555 !important;
      margin: 0 auto 28px !important;
      max-width: 560px;
    }
    .mc-contact-page .mc-contact-hero__actions {
      display: flex !important;
      flex-wrap: wrap;
      gap: 14px;
      justify-content: center !important;
    }
    .mc-contact-page .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 14px 28px;
      border-radius: 999px;
      font-weight: 600;
      font-size: 0.95rem;
      text-decoration: none;
      border: none;
      cursor: pointer;
      font-family: inherit;
      transition: transform 0.35s ease, box-shadow 0.35s ease, background 0.35s ease;
    }
    .mc-contact-page .btn-primary {
      background: var(--red);
      color: #fff;
      box-shadow: 0 14px 32px rgba(208, 0, 0, 0.3);
    }
    .mc-contact-page .btn-primary:hover { transform: translateY(-3px); }
    .mc-contact-page .btn-outline {
      background: #fff;
      color: var(--red);
      border: 2px solid var(--red);
    }
    .mc-contact-page .btn-outline:hover {
      background: var(--red);
      color: #fff;
    }
    /* Sections */
    .mc-contact-page .mc-section {
      padding: 48px 0;
    }
    .mc-contact-page .section-title {
      text-align: center;
      font-size: clamp(1.6rem, 3.5vw, 2rem);
      font-weight: 800;
      color: var(--red);
      margin: 0 0 28px;
    }
    /* Price table */
    .mc-contact-page .mc-price-table-wrap {
      overflow-x: auto;
      border-radius: var(--radius);
      box-shadow: var(--shadow-soft);
      border: 1px solid var(--border);
      background: #fff;
    }
    .mc-contact-page .mc-price-table {
      width: 100%;
      border-collapse: collapse;
    }
    .mc-contact-page .mc-price-table thead {
      background: linear-gradient(135deg, #fef2f2, #fff7ed);
    }
    .mc-contact-page .mc-price-table th {
      padding: 14px 18px;
      text-align: left;
      color: var(--red);
      font-weight: 700;
      font-size: 0.9rem;
    }
    .mc-contact-page .mc-price-table td {
      padding: 14px 18px;
      border-bottom: 1px solid #f3f4f6;
      color: #374151;
    }
    .mc-contact-page .mc-price-table tbody tr {
      transition: background 0.2s ease;
    }
    .mc-contact-page .mc-price-table tbody tr:hover {
      background: #fef2f2;
    }
    .mc-contact-page .mc-price-table td:last-child {
      font-weight: 700;
      color: var(--red);
      white-space: nowrap;
    }
    /* Mobile price table (VAMIBEX 18.10.2026) */
    @media (max-width: 480px) {
      .mc-contact-page .mc-price-table th,
      .mc-contact-page .mc-price-table td {
        padding: 10px 10px;
        font-size: 0.85rem;
      }
      .mc-contact-page .mc-price-table th:nth-child(2),
      .mc-contact-page .mc-price-table td:nth-child(2) {
        display: none;
      }
    }
    /* Office + map */
    .mc-contact-page .mc-offices-map {
      display: grid;
      grid-template-columns: 1fr 1.1fr;
      gap: 28px;
      align-items: stretch;
    }
    .mc-contact-page .mc-offices-card {
      background: #fff;
      border-radius: var(--radius);
      padding: 28px;
      box-shadow: var(--shadow-soft);
      border: 1px solid var(--border);
    }
    .mc-contact-page .mc-offices-card h2 {
      font-size: 1.35rem;
      font-weight: 800;
      color: var(--red);
      margin: 0 0 10px;
    }
    .mc-contact-page .mc-offices-card p {
      color: var(--muted);
      margin: 0 0 18px;
    }
    .mc-contact-page .mc-office-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .mc-contact-page .mc-office-list li {
      border-radius: 12px;
      background: #fef2f2;
      transition: background 0.25s ease, transform 0.25s ease;
    }
    .mc-contact-page .mc-office-list a {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 14px 16px;
      color: var(--red);
      font-weight: 600;
      text-decoration: none;
    }
    .mc-contact-page .mc-office-list li:hover {
      background: #fee2e2;
      transform: translateX(4px);
    }
    .mc-contact-page .mc-map-frame {
      border-radius: var(--radius);
      box-shadow: var(--shadow-soft);
      border: 1px solid var(--border);
      overflow: hidden;
      min-height: 320px;
      background: #e5e7eb;
    }
    .mc-contact-page .mc-map-frame iframe {
      width: 100%;
      height: 100%;
      min-height: 320px;
      border: 0;
      display: block;
    }
    /* Unified contact panel */
    .mc-contact-page .mc-contact-form-section {
      padding: 0 0 56px;
    }
    .mc-contact-page .contact-panel {
      background: #fff;
      border-radius: 24px;
      box-shadow: 0 20px 50px rgba(208, 0, 0, 0.08);
      border: 1px solid rgba(208, 0, 0, 0.08);
      overflow: hidden;
    }
    .mc-contact-page .contact-panel__head {
      padding: 32px 32px 24px;
      background: linear-gradient(135deg, #fef2f2 0%, #fff7ed 50%, #fff 100%);
      border-bottom: 1px solid rgba(208, 0, 0, 0.08);
      text-align: center;
    }
    .mc-contact-page .contact-panel__head h2 {
      margin: 0 0 8px;
      font-size: clamp(1.5rem, 3vw, 1.85rem);
      font-weight: 800;
      color: var(--red);
    }
    .mc-contact-page .contact-panel__head p {
      margin: 0 0 20px;
      color: var(--muted);
      font-size: 1rem;
      max-width: 520px;
      margin-inline: auto;
    }
    .mc-contact-page .contact-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      justify-content: center;
    }
    .mc-contact-page .contact-chip {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 18px;
      border-radius: 999px;
      background: #fff;
      border: 1px solid rgba(208, 0, 0, 0.15);
      color: var(--text);
      text-decoration: none;
      font-weight: 600;
      font-size: 0.9rem;
      transition: background 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
    }
    .mc-contact-page .contact-chip i { color: var(--red); }
    .mc-contact-page .contact-chip:hover {
      background: #fef2f2;
      border-color: var(--red);
      transform: translateY(-2px);
    }
    .mc-contact-page .contact-panel__body { padding: 32px; }
    .mc-contact-page .mc-form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
    .mc-contact-page .mc-field { display: flex; flex-direction: column; gap: 6px; }
    .mc-contact-page .mc-field--full { grid-column: 1 / -1; }
    .mc-contact-page .mc-field label {
      font-size: 0.85rem;
      font-weight: 600;
      color: #374151;
    }
    .mc-contact-page .mc-input,
    .mc-contact-page .mc-textarea {
      width: 100%;
      padding: 14px 16px;
      border: 1px solid #e5e7eb;
      border-radius: 14px;
      font-size: 0.95rem;
      font-family: inherit;
      color: var(--text);
      background: #fafafa;
      transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }
    .mc-contact-page .mc-textarea {
      min-height: 120px;
      resize: vertical;
    }
    .mc-contact-page .mc-input:focus,
    .mc-contact-page .mc-textarea:focus {
      outline: none;
      border-color: var(--red);
      background: #fff;
      box-shadow: 0 0 0 4px rgba(208, 0, 0, 0.1);
    }
    .mc-contact-page .form-verify-block {
      margin-top: 20px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.35rem;
    }
    .mc-contact-page .turnstile-modal-widget-wrap {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .mc-contact-page .form-security-loading {
      display: flex;
      align-items: center;
      gap: 0.375rem;
      color: #9ca3af;
      font-size: 0.8rem;
    }
    .mc-contact-page .form-security-spinner {
      width: 0.875rem;
      height: 0.875rem;
      border: 2px solid #e5e7eb;
      border-top-color: var(--red);
      border-radius: 50%;
      animation: mcContactSpin 0.7s linear infinite;
    }
    @keyframes mcContactSpin { to { transform: rotate(360deg); } }
    .mc-contact-page .turnstile-modal-widget {
      display: flex;
      justify-content: center;
      width: 100%;
    }
    .mc-contact-page .turnstile-modal-status {
      font-size: 0.82rem;
      text-align: center;
      color: #6b7280;
      min-height: 1rem;
    }
    .mc-contact-page [data-form-result] {
      margin-top: 12px;
      min-height: 1.25rem;
      font-size: 0.95rem;
      text-align: center;
    }
    .mc-contact-page .mc-submit-btn {
      width: 100%;
      margin-top: 20px;
      padding: 16px 24px;
      border-radius: 999px;
      border: none;
      background: var(--red);
      color: #fff;
      font-size: 1rem;
      font-weight: 700;
      font-family: inherit;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: background 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
      box-shadow: 0 12px 28px rgba(208, 0, 0, 0.25);
    }
    .mc-contact-page .mc-submit-btn:hover:not(:disabled) {
      background: #b91c1c;
      transform: translateY(-2px);
    }
    .mc-contact-page .mc-submit-btn:disabled {
      background: #d1d5db;
      box-shadow: none;
      cursor: not-allowed;
      transform: none;
    }
    .mc-contact-page .reveal {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.7s ease, transform 0.7s ease;
    }
    .mc-contact-page .reveal.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
    @media (max-width: 900px) {
      .mc-contact-page .mc-offices-map { grid-template-columns: 1fr; }
    }
    @media (max-width: 768px) {
      .mc-contact-page .mc-form-grid { grid-template-columns: 1fr; }
      .mc-contact-page .contact-panel__head,
      .mc-contact-page .contact-panel__body { padding: 24px 20px; }
    }
    @media (max-width: 600px) {
      .mc-contact-page .mc-contact-hero { padding: 72px 16px 52px; }
      .mc-contact-page .mc-contact-hero__actions { flex-direction: column; }
      .mc-contact-page .mc-contact-hero__actions .btn { width: 100%; max-width: 320px; }
      .mc-contact-page .contact-chips { flex-direction: column; align-items: stretch; }
      .mc-contact-page .contact-chip { justify-content: center; }
    }
</style>
  <section class="mc-contact-hero">
    <div class="mc-contact-hero__orb mc-contact-hero__orb--1" aria-hidden="true"></div>
    <div class="mc-contact-hero__orb mc-contact-hero__orb--2" aria-hidden="true"></div>
    <div class="mc-contact-hero__wrap">
      <h1 class="mc-contact-hero__title">Contact – accounting firm in Sofia</h1>
      <p class="mc-contact-hero__sub">Mehov Consult – accounting, company registration and tax consultancy in Sofia</p>
      <div class="mc-contact-hero__actions">
        <a href="tel:+359879884488" class="btn btn-primary">Call +359&nbsp;879&nbsp;88&nbsp;44&nbsp;88</a>
        <a href="#contact-form" class="btn btn-outline">Send a message</a>
      </div>
<!-- mc-hero-call (VAMIBEX 22.10.2026) -->
<p class="mc-hero-call" style="margin: 14px auto 0; font-size: 0.95rem; line-height: 1.5; opacity: 0.92; max-width: 640px;">Contact Doychin Mehov. Tell him briefly what you need – he will explain the next steps and you will get a quote.</p>
    </div>
  </section>
  <section class="mc-section reveal">
    <div class="container--wide">
      <h2 class="section-title">Sample Price List (€)</h2>
      <div class="mc-price-table-wrap">
        <table class="mc-price-table">
          <thead>
            <tr>
              <th>Service</th>
              <th>Description</th>
              <th>Price</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Accounting Services – Monthly</td>
              <td>Professional monthly accounting</td>
              <td>from 120&nbsp;€</td>
            </tr>
            <tr>
              <td>Consultancy Services – Hourly</td>
              <td>Tax and business consultancy</td>
              <td>from 50&nbsp;€</td>
            </tr>
            <tr>
              <td>Company Registration</td>
              <td>Start a new business quickly and easily</td>
              <td>179&nbsp;€</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>
  <section class="mc-section reveal">
    <div class="container--wide">
      <div class="mc-offices-map">
        <div class="mc-offices-card">
          <h2>Our Office</h2>
          <p>Mehov Consult, Sofia 1756, Darvenitsa District, Block 48, Entrance V, Office 6</p>
          <ul class="mc-office-list">
            <li>
              <a href="https://www.google.com/maps/place/?q=place_id:ChIJKYuqCJOHqkARFyfQ6WuECrI" target="_blank" rel="noopener noreferrer">Open in Google Maps</a>
            </li>
          </ul>
        </div>
        <div class="mc-map-frame">
          <iframe
            src="https://www.google.com/maps?q=%D0%9C%D0%B5%D1%85%D0%BE%D0%B2+%D0%9A%D0%BE%D0%BD%D1%81%D1%83%D0%BB%D1%82,+%D0%B6%D0%BA.+%D0%94%D1%8A%D1%80%D0%B2%D0%B5%D0%BD%D0%B8%D1%86%D0%B0+48,+1756+%D0%A1%D0%BE%D1%84%D0%B8%D1%8F&amp;z=16&amp;output=embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Mehov Consult office location in Sofia"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </div>
  </section>
  <section
    class="mc-contact-form-section reveal"
    id="contact-form" data-form-section
    data-form-lang="en"
  >
    <div class="container">
      <div class="contact-panel">
        <div class="contact-panel__head">
          <h2>Contact us</h2>
          <p>Send us a message and we'll get back to you as soon as possible.</p>
          <div class="contact-chips">
            <a href="tel:+359879884488" class="contact-chip">+359 879 88 44 88</a>
            <a href="mailto:d.mehov@gmail.com" class="contact-chip">d.mehov@gmail.com</a>
          </div>
        </div>
        <div class="contact-panel__body">
          <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" id="mc-contact-form"><input type="hidden" name="form-name" value="contact"/><input type="hidden" name="page" value="/en/contact"/><p class="mc-hp" hidden><label>Leave empty: <input name="bot-field" tabindex="-1" autocomplete="off"/></label></p>
            <div class="mc-form-grid">
              <div class="mc-field">
                <label for="cf-name">Name *</label>
                <input class="mc-input" type="text" id="cf-name" name="name" required autocomplete="name" placeholder="Your name">
              </div>
              <div class="mc-field">
                <label for="cf-company">Company</label>
                <input class="mc-input" type="text" id="cf-company" name="company" autocomplete="organization" placeholder="Company name">
              </div>
              <div class="mc-field">
                <label for="cf-phone">Phone *</label>
                <input class="mc-input" type="tel" id="cf-phone" name="phone" required autocomplete="tel" placeholder="+359 …">
              </div>
              <div class="mc-field">
                <label for="cf-email">Email *</label>
                <input class="mc-input" type="email" id="cf-email" name="email" required autocomplete="email" placeholder="you@company.com">
              </div>
              <div class="mc-field mc-field--full">
                <label for="cf-message">Message *</label>
                <textarea class="mc-textarea" id="cf-message" name="message" required placeholder="How can we help?"></textarea>
              </div>
            </div>
            <div class="form-verify-block">
            </div>
            <button type="submit" class="mc-submit-btn" data-form-submit data-submit-label="Send enquiry" aria-busy="false">
                            <span>Send enquiry</span>
            </button>
            <p class="mc-privacy-note">By submitting this form you agree to the processing of your data as described in our <a href="/en/privacy-policy">Privacy Policy</a>.</p>
            <div data-form-result role="status" aria-live="polite"></div>
          </form>
        </div>
      </div>
    </div>
  </section>
</main>
<!--Note:this Script shouldn't be deleted or updated for the form to work correctly on storing data and sending email-->
<!-- CRITICAL:START form-widget-submit — Do not remove without explicit approval. -->
<!-- CRITICAL:END form-widget-submit -->
<script is:inline>
(function () {
  if ("IntersectionObserver" in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) {
          e.target.classList.add("is-visible");
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.1 });
    document.querySelectorAll(".mc-contact-page .reveal").forEach(function (el) { io.observe(el); });
  } else {
    document.querySelectorAll(".mc-contact-page .reveal").forEach(function (el) { el.classList.add("is-visible"); });
  }
})();
</script>
</div> 
