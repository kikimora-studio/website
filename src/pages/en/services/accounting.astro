---
import Layout from '../../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://mehovconsult.com/en/services/accounting",
      "name": "Accounting Services in Sofia for Small and Medium Businesses | Mehov Consult",
      "description": "Monthly accounting services for companies in Sofia: bookkeeping, VAT, payroll, annual closing. A quote based on the size of your business.",
      "url": "https://mehovconsult.com/en/services/accounting",
      "inLanguage": "en",
      "isPartOf": {
        "@type": "WebSite",
        "name": "Мехов Консулт",
        "url": "https://mehovconsult.com/bg"
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://mehovconsult.com/en/services/accounting#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How much does monthly accounting cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Prices start from 120 € per month and depend on the volume of documents, the number of employees and whether the company is VAT-registered. Contact us for a quote tailored to your business."
          }
        },
        {
          "@type": "Question",
          "name": "Do you work with companies outside Sofia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. We also work remotely — document exchange and communication happen online, so it does not matter where your company is based."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need an accountant if I'm a sole trader or have minimal turnover?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You are required to keep accounts: by law every trader, including a sole trader, keeps accounts and files annual reports, regardless of turnover. That is why most sole traders use an accountant. Proper bookkeeping protects you from fines and problems during audits."
          }
        },
        {
          "@type": "Question",
          "name": "Can I switch from my current accountant to you mid-year?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. We handle the transfer of documentation and ensure a smooth transition with no interruption to your company's service."
          }
        }
      ]
    }
  ]
};
---
<Layout lang="en" path="/en/services/accounting" title={"Accounting Services in Sofia for SMEs | Mehov Consult"} description={"Monthly accounting services for companies in Sofia: bookkeeping, VAT, payroll, annual closing. A quote based on the size of your business."} schema={schema}>
<main class="mc-service">
  <style is:inline>
    .mc-service {
      --brand: #d00000;
      --brand-2: #4d0000;
      --red: #d00000;
      --red-dark: #b91c1c;
      --text: #15181b;
      --muted: #5b6672;
      --surface: #ffffff;
      --bg: #fefefe;
      --border: rgba(0, 0, 0, 0.06);
      --radius: 20px;
      --shadow: 0 20px 60px rgba(0, 0, 0, 0.10);
      --shadow-soft: 0 12px 30px rgba(0, 0, 0, 0.07);
      font-family: "PT Sans", system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
      color: var(--text);
      background: var(--bg);
      line-height: 1.6;
      max-width: 100%;
    }
    .mc-service * { box-sizing: border-box; }
    .mc-service .container {
      width: 100%;
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 20px;
    }
    .mc-service .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 14px 28px;
      border-radius: 999px;
      font-weight: 700;
      font-size: 0.95rem;
      text-decoration: none;
      border: none;
      cursor: pointer;
      font-family: inherit;
      transition: transform 0.3s ease, box-shadow 0.3s ease, background 0.3s ease, color 0.3s ease;
    }
    .mc-service .btn-orange {
      background: var(--brand);
      color: #fff;
      box-shadow: 0 15px 40px rgba(208, 0, 0, 0.3);
    }
    .mc-service .btn-orange:hover { transform: translateY(-3px); background: var(--red-dark); }
    .mc-service .btn-outline {
      background: #fff;
      color: var(--red);
      border: 2px solid var(--red);
    }
    .mc-service .btn-outline:hover { background: var(--red); color: #fff; }
    /* HERO — семпъл градиент, без снимка */
    .mc-service .svc-hero {
      position: relative;
      padding: 96px 20px 72px;
      text-align: center;
      overflow: hidden;
      background:
        radial-gradient(circle at 15% 20%, rgba(208, 0, 0, 0.10), transparent 45%),
        radial-gradient(circle at 85% 75%, rgba(208, 0, 0, 0.06), transparent 42%),
        linear-gradient(120deg, #ffffff, #fdf2f2);
    }
    .mc-service .svc-hero__wrap {
      position: relative;
      z-index: 1;
      max-width: 720px;
      margin: 0 auto;
      animation: svcFadeUp 0.8s ease-out both;
    }
    @keyframes svcFadeUp {
      from { opacity: 0; transform: translateY(26px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .mc-service .svc-hero__eyebrow {
      display: inline-block;
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--red);
      background: rgba(208, 0, 0, 0.08);
      padding: 6px 16px;
      border-radius: 999px;
      margin-bottom: 20px;
    }
    .mc-service .svc-hero__title {
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 800;
      color: var(--red);
      margin: 0 0 16px;
      line-height: 1.15;
    }
    .mc-service .svc-hero__sub {
      font-size: clamp(1.05rem, 2.2vw, 1.2rem);
      color: var(--muted);
      margin: 0 auto 30px;
      max-width: 620px;
    }
    .mc-service .svc-hero__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      justify-content: center;
    }
    /* INTRO */
    .mc-service .svc-intro {
      padding: 64px 0 24px;
    }
    .mc-service .svc-intro__inner {
      max-width: 800px;
      margin: 0 auto;
      text-align: center;
    }
    .mc-service .svc-intro h2 {
      font-size: clamp(1.6rem, 3.5vw, 2.1rem);
      color: var(--brand-2);
      font-weight: 800;
      margin: 0 0 18px;
    }
    .mc-service .svc-intro p {
      font-size: 1.08rem;
      color: var(--muted);
      margin: 0 0 16px;
    }
    /* INCLUDES — grid of what's covered */
    .mc-service .svc-includes {
      padding: 48px 0 56px;
    }
    .mc-service .svc-includes h2 {
      text-align: center;
      font-size: clamp(1.5rem, 3.5vw, 2rem);
      color: var(--brand-2);
      font-weight: 800;
      margin: 0 0 36px;
    }
    .mc-service .svc-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 20px;
    }
    @media (min-width: 720px) {
      .mc-service .svc-grid { grid-template-columns: repeat(2, 1fr); }
    }
    .mc-service .svc-card {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 26px 24px;
      box-shadow: var(--shadow-soft);
      transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
      display: flex;
      gap: 16px;
      align-items: flex-start;
    }
    .mc-service .svc-card:hover {
      transform: translateY(-5px);
      box-shadow: var(--shadow);
      border-color: rgba(208, 0, 0, 0.15);
    }
    .mc-service .svc-card__icon {
      flex-shrink: 0;
      width: 46px;
      height: 46px;
      border-radius: 12px;
      background: rgba(208, 0, 0, 0.08);
      color: var(--red);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .mc-service .svc-card__icon svg { width: 24px; height: 24px; }
    .mc-service .svc-card h3 {
      margin: 0 0 6px;
      font-size: 1.08rem;
      font-weight: 700;
      color: var(--text);
    }
    .mc-service .svc-card p {
      margin: 0;
      font-size: 0.96rem;
      color: var(--muted);
      line-height: 1.55;
    }
    /* WHY */
    .mc-service .svc-why {
      padding: 56px 0;
      background: #f9fafb;
    }
    .mc-service .svc-why__inner {
      max-width: 820px;
      margin: 0 auto;
      text-align: center;
    }
    .mc-service .svc-why h2 {
      font-size: clamp(1.5rem, 3.5vw, 2rem);
      color: var(--brand-2);
      font-weight: 800;
      margin: 0 0 18px;
    }
    .mc-service .svc-why p {
      font-size: 1.08rem;
      color: var(--muted);
      margin: 0 0 16px;
    }
    /* FAQ */
    .mc-service .svc-faq {
      padding: 56px 0 64px;
    }
    .mc-service .svc-faq h2 {
      text-align: center;
      font-size: clamp(1.5rem, 3.5vw, 2rem);
      color: var(--brand-2);
      font-weight: 800;
      margin: 0 0 32px;
    }
    .mc-service .faq-item {
      max-width: 800px;
      margin: 0 auto 12px;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      overflow: hidden;
      background: #fff;
      box-shadow: var(--shadow-soft);
    }
    .mc-service .faq-question {
      width: 100%;
      padding: 18px 22px;
      border: 0;
      background: #fff;
      text-align: left;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      font-family: inherit;
      color: var(--text);
    }
    .mc-service .faq-question span {
      color: var(--red);
      font-size: 1.3rem;
      transition: transform 0.25s ease;
      flex-shrink: 0;
    }
    .mc-service .faq-answer {
      max-height: 0;
      overflow: hidden;
      background: #fafafa;
      padding: 0 22px;
      transition: all 0.4s ease;
      color: var(--muted);
      line-height: 1.7;
    }
    .mc-service .faq-item.active .faq-answer { max-height: 300px; padding: 0 22px 18px; }
    .mc-service .faq-item.active .faq-question span { transform: rotate(45deg); }
    /* CTA */
    .mc-service .svc-cta {
      padding: 0 20px 64px;
      text-align: center;
    }
    .mc-service .svc-cta__inner {
      max-width: 1100px;
      margin: 0 auto;
      padding: 52px 24px;
      border-radius: 24px;
      background: linear-gradient(120deg, rgba(208, 0, 0, 0.10), #fff);
      border: 1px solid rgba(208, 0, 0, 0.08);
    }
    .mc-service .svc-cta__inner h2 {
      font-size: clamp(1.7rem, 4vw, 2.3rem);
      color: var(--red);
      font-weight: 800;
      margin: 0 0 14px;
    }
    .mc-service .svc-cta__inner p {
      font-size: 1.1rem;
      color: var(--muted);
      max-width: 640px;
      margin: 0 auto 28px;
    }
    .mc-service .svc-cta__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      justify-content: center;
    }
    /* MODAL */
    .mc-service .modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.55);
      justify-content: center;
      align-items: flex-start;
      padding: 40px 20px;
      z-index: 99999;
      overflow-y: hidden;
      backdrop-filter: blur(4px);
    }
    .mc-service .modal.show { display: flex; overflow-y: auto; }
    .mc-service .modal-content {
      background: #fff;
      border-radius: 24px;
      padding: 32px;
      max-width: 640px;
      width: 100%;
      position: relative;
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.2);
    }
    .mc-service .modal-content h2 { color: var(--red-dark); margin: 0 0 10px; font-size: 1.5rem; }
    .mc-service .modal-content > p { margin: 0 0 16px; color: var(--muted); }
    .mc-service #closeModal {
      position: absolute;
      top: 14px;
      right: 18px;
      font-size: 28px;
      font-weight: 700;
      color: #111;
      cursor: pointer;
      background: none;
      border: 0;
      padding: 0;
      line-height: 1;
    }
    .mc-service #closeModal:hover { color: var(--red-dark); }
    .mc-service .modal-form {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      margin-top: 14px;
    }
    .mc-service .modal-form .field-full { grid-column: 1 / -1; }
    .mc-service .modal-form input,
    .mc-service .modal-form textarea {
      border: 1px solid #ddd;
      border-radius: 14px;
      padding: 14px 16px;
      width: 100%;
      font-size: 14px;
      font-family: inherit;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .mc-service .modal-form textarea { min-height: 110px; resize: vertical; }
    .mc-service .modal-form input:focus,
    .mc-service .modal-form textarea:focus {
      outline: none;
      border-color: var(--red);
      box-shadow: 0 0 0 4px rgba(208, 0, 0, 0.12);
    }
    .mc-service .modal-form .form-verify-block {
      grid-column: 1 / -1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.25rem;
    }
    .mc-service .modal-form .turnstile-modal-widget-wrap {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .mc-service .modal-form .form-security-loading {
      display: flex;
      align-items: center;
      gap: 0.375rem;
      color: #9ca3af;
      font-size: 0.8rem;
    }
    .mc-service .modal-form .form-security-spinner {
      width: 0.875rem;
      height: 0.875rem;
      border: 2px solid #e5e7eb;
      border-top-color: var(--red);
      border-radius: 50%;
      animation: svcSpin 0.7s linear infinite;
    }
    @keyframes svcSpin { to { transform: rotate(360deg); } }
    .mc-service .modal-form .turnstile-modal-widget { display: flex; justify-content: center; width: 100%; }
    .mc-service .modal-form .turnstile-modal-status { font-size: 0.8rem; text-align: center; color: #6b7280; }
    .mc-service .modal-form [data-form-result] { grid-column: 1 / -1; min-height: 1.25rem; font-size: 0.95rem; }
    .mc-service .modal-form button[type="submit"] {
      grid-column: 1 / -1;
      background: var(--red-dark);
      color: #fff;
      padding: 14px 24px;
      border-radius: 40px;
      font-weight: 600;
      cursor: pointer;
      border: 0;
      font-family: inherit;
      font-size: 1rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }
    .mc-service .modal-form button[type="submit"]:hover:not(:disabled) { background: #991b1b; }
    .mc-service .modal-form button[type="submit"]:disabled { background: #9ca3af; cursor: not-allowed; }
    .mc-service .reveal { opacity: 0; transform: translateY(24px); transition: opacity 0.7s ease, transform 0.7s ease; }
    .mc-service .reveal.is-visible { opacity: 1; transform: translateY(0); }
    @media (max-width: 600px) {
      .mc-service .svc-hero { padding: 76px 16px 56px; }
      .mc-service .svc-hero__actions,
      .mc-service .svc-cta__actions { flex-direction: column; align-items: center; }
      .mc-service .svc-hero__actions .btn,
      .mc-service .svc-cta__actions .btn { width: 100%; max-width: 320px; }
      .mc-service .modal-form { grid-template-columns: 1fr; }
      .mc-service .svc-card { flex-direction: column; }
    }
  </style>
