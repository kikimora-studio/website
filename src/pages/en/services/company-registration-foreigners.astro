---
import Layout from '../../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://mehovconsult.com/en/services/company-registration-foreigners",
      "url": "https://mehovconsult.com/en/services/company-registration-foreigners",
      "name": "Register a Company in Bulgaria as a Foreigner",
      "description": "How foreigners register an EOOD or OOD in Bulgaria in 2026: documents, registered address, minimum capital of 1 €, remote registration, taxes and residence.",
      "inLanguage": "en",
      "isPartOf": {
        "@type": "WebSite",
        "name": "Mehov Consult",
        "url": "https://mehovconsult.com/en"
      },
      "about": {
        "@id": "https://mehovconsult.com/#organization"
      }
    },
    {
      "@type": "Service",
      "name": "Company Registration in Bulgaria for Foreigners",
      "serviceType": "Company registration",
      "areaServed": {
        "@type": "Country",
        "name": "Bulgaria"
      },
      "provider": {
        "@id": "https://mehovconsult.com/#organization"
      },
      "url": "https://mehovconsult.com/en/services/company-registration-foreigners"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Can a non-EU citizen own and manage a Bulgarian company?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Citizenship is not a restriction for owning or managing an EOOD or OOD. You do not need a Bulgarian co-owner or a Bulgarian manager."
          }
        },
        {
          "@type": "Question",
          "name": "Can the registration be done remotely?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In most cases yes, through a notarised power of attorney with an apostille and a certified translation. Banks may require the owner to appear in person once to open the account."
          }
        },
        {
          "@type": "Question",
          "name": "What taxes does a Bulgarian company pay?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Corporate income tax is 10%. Dividends paid to individuals are taxed at 5%. VAT is 20%, and VAT registration is mandatory once taxable turnover in a calendar year exceeds 51 130 €."
          }
        },
        {
          "@type": "Question",
          "name": "Does owning a company give me the right to live in Bulgaria?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No, not by itself. Owning or managing a company from abroad does not require a residence permit, but living in Bulgaria does. The conditions depend on your situation – Doychin Mehov will explain them when you talk."
          }
        }
      ]
    }
  ]
