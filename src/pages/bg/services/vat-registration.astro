---
import Layout from '../../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://mehovconsult.com/bg/services/vat-registration",
      "url": "https://mehovconsult.com/bg/services/vat-registration",
      "name": "Регистрация по ДДС 2026 – праг 51 130 € | Мехов Консулт",
      "description": "Задължителна и доброволна регистрация по ДДС през 2026 г.: праг 51 130 €, срок 7 дни, документи и месечни справки. Подаваме заявлението вместо вас.",
      "inLanguage": "bg",
      "isPartOf": {
        "@type": "WebSite",
        "name": "Мехов Консулт",
        "url": "https://mehovconsult.com/bg"
      },
      "about": {
        "@id": "https://mehovconsult.com/#organization"
      }
    },
    {
      "@type": "Service",
      "name": "Регистрация по ДДС в София",
      "serviceType": "Регистрация по ДДС",
      "areaServed": [
        {
          "@type": "City",
          "name": "София"
        },
        {
          "@type": "Country",
          "name": "България"
        }
      ],
      "provider": {
        "@id": "https://mehovconsult.com/#organization"
      },
      "url": "https://mehovconsult.com/bg/services/vat-registration"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Какъв е прагът за регистрация по ДДС през 2026 г.?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "51 130 € облагаем оборот от началото на календарната година. От 2026 г. оборотът се смята за календарната година, а не за последните 12 месеца."
          }
        },
        {
          "@type": "Question",
          "name": "В какъв срок трябва да се подаде заявлението?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "До 7 дни от деня, в който оборотът е надхвърлил прага. Затова при оборот близо до прага той трябва да се следи постоянно."
          }
        },
        {
          "@type": "Question",
          "name": "Кога има смисъл доброволна регистрация?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Обикновено когато клиентите ви са фирми, регистрирани по ДДС, когато предстоят големи покупки или когато работите с фирми от други държави от ЕС. Ако продавате основно на граждани, регистрацията вдига цената ви с 20%."
          }
        },
        {
          "@type": "Question",
          "name": "Какво се променя след регистрацията?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Начислявате ДДС във всяка фактура, водите дневници за покупки и продажби и подавате справка-декларация всеки месец до 14-о число, дори когато няма продажби."
          }
        }
      ]
    }
  ]
};
---
<Layout lang="bg" path="/bg/services/vat-registration" title={"Регистрация по ДДС 2026 – праг 51 130 € | Мехов Консулт"} description={"Задължителна и доброволна регистрация по ДДС през 2026 г.: праг 51 130 €, срок 7 дни, документи и месечни справки. Подаваме заявлението вместо вас."} schema={schema}>
<style is:inline>
/* landing pages (VAMIBEX 19.10.2026) */
.mc-landing { color: #1f2937; line-height: 1.7; }
.mc-landing .lp-hero { background: #111827; color: #fff; padding: 64px 20px 56px; }
.mc-landing .lp-wrap { max-width: 980px; margin: 0 auto; }
.mc-landing .lp-hero h1 { font-size: 2.3rem; line-height: 1.2; margin: 0 0 16px; color: #fff; }
.mc-landing .lp-hero p { font-size: 1.1rem; color: #e5e7eb; margin: 0 0 24px; max-width: 760px; }
.mc-landing .lp-actions { display: flex; flex-wrap: wrap; gap: 12px; }
.mc-landing .lp-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 24px; border-radius: 10px; font-weight: 700; text-decoration: none; }
.mc-landing .lp-btn--main { background: #d00000; color: #fff; }
.mc-landing .lp-btn--ghost { border: 2px solid #fff; color: #fff; }
.mc-landing .lp-trust { list-style: none; display: flex; flex-wrap: wrap; gap: 8px 20px; padding: 0; margin: 18px 0 0; font-weight: 600; }
.mc-landing .lp-trust li::before { content: "✓"; margin-right: 6px; color: #22c55e; font-weight: 800; }
.mc-landing .lp-sec { padding: 48px 20px 8px; }
.mc-landing .lp-sec h2 { font-size: 1.6rem; margin: 0 0 16px; color: #111827; }
.mc-landing .lp-sec h3 { font-size: 1.1rem; margin: 22px 0 6px; color: #111827; }
.mc-landing .lp-list { padding-left: 22px; }
.mc-landing .lp-list li { margin: 0 0 8px; }
.mc-landing .lp-steps { counter-reset: s; list-style: none; padding: 0; display: grid; gap: 14px; }
.mc-landing .lp-steps li { counter-increment: s; position: relative; padding: 14px 16px 14px 60px; background: #f9fafb; border-radius: 12px; }
.mc-landing .lp-steps li::before { content: counter(s); position: absolute; left: 16px; top: 14px; width: 30px; height: 30px; border-radius: 50%; background: #d00000; color: #fff; font-weight: 800; display: flex; align-items: center; justify-content: center; }
.mc-landing .lp-related a { color: #d00000; }
.mc-landing .lp-cta { margin: 48px 20px 64px; padding: 32px 24px; background: #fef2f2; border-radius: 16px; text-align: center; }
.mc-landing .lp-cta h2 { margin: 0 0 10px; font-size: 1.5rem; color: #111827; }
.mc-landing .lp-cta p { margin: 0 0 18px; }
.mc-landing .lp-cta .lp-btn--ghost { border-color: #d00000; color: #d00000; }
.mc-landing .lp-cta .lp-actions { justify-content: center; }
@media (max-width: 600px) {
  .mc-landing .lp-hero { padding: 44px 16px 40px; }
  .mc-landing .lp-hero h1 { font-size: 1.8rem; }
  .mc-landing .lp-btn { width: 100%; }
}
</style>
<main class="mc-landing">
<section class="lp-hero"><div class="lp-wrap">
<h1>Регистрация по ДДС в София</h1>
<p>Следим оборота ви, подаваме заявлението в НАП в срок и поемаме месечните справки-декларации след регистрацията. Помагаме и да решите дали доброволната регистрация има смисъл за вас.</p>
<div class="lp-actions"><a class="lp-btn lp-btn--main" href="tel:+359879884488">Обадете се: 0879 88 44 88</a><a class="lp-btn lp-btn--ghost" href="/bg/contact#contact-form">Поискайте безплатна оферта</a></div>
<!-- mc-hero-call (VAMIBEX 20.10.2026) -->
<p class="mc-hero-call" style="margin: 14px 0 0; font-size: 0.95rem; line-height: 1.5; opacity: 0.92; max-width: 640px;">Свържете се с Дойчин Мехов. Разкажете накратко какво ви трябва – той ще ви каже следващите стъпки и ще получите оферта.</p>
<ul class="lp-trust"><li>Говорите директно с Дойчин Мехов</li><li>Офис в София, жк. Дървеница</li><li>Над 25 години опит</li></ul>
</div></section>
<section class="lp-sec"><div class="lp-wrap">
<h2>Какво включва услугата</h2>
<ul class="lp-list"><li>Проверка дали регистрацията е задължителна или е по ваш избор</li><li>Подготовка и подаване на заявлението за регистрация по ДДС в НАП</li><li>Регистрация по чл. 97а ЗДДС, ако предоставяте услуги на фирми в други държави от ЕС</li><li>Месечни справки-декларации и дневници за покупки и продажби до 14-о число</li><li>Следене на оборота спрямо прага, за да не изпуснете 7-дневния срок</li></ul>
</div></section>
<section class="lp-sec"><div class="lp-wrap">
<h2>Как работим</h2>
<ol class="lp-steps"><li>Пишете ни или се обадете – уточняваме оборота и дейността ви</li><li>Казваме дали регистрацията е задължителна и от кога</li><li>Подготвяме документите и подаваме заявлението в НАП</li><li>След регистрацията поемаме ДДС отчетността всеки месец</li></ol>
</div></section>
<section class="lp-sec lp-faq"><div class="lp-wrap">
<h2>Често задавани въпроси</h2>
<h3>Какъв е прагът за регистрация по ДДС през 2026 г.?</h3>
<p>51 130 € облагаем оборот от началото на календарната година. От 2026 г. оборотът се смята за календарната година, а не за последните 12 месеца.</p>
<h3>В какъв срок трябва да се подаде заявлението?</h3>
<p>До 7 дни от деня, в който оборотът е надхвърлил прага. Затова при оборот близо до прага той трябва да се следи постоянно.</p>
<h3>Кога има смисъл доброволна регистрация?</h3>
<p>Обикновено когато клиентите ви са фирми, регистрирани по ДДС, когато предстоят големи покупки или когато работите с фирми от други държави от ЕС. Ако продавате основно на граждани, регистрацията вдига цената ви с 20%.</p>
<h3>Какво се променя след регистрацията?</h3>
<p>Начислявате ДДС във всяка фактура, водите дневници за покупки и продажби и подавате справка-декларация всеки месец до 14-о число, дори когато няма продажби.</p>
</div></section>
<section class="lp-sec lp-related"><div class="lp-wrap">
<h2>Полезно от блога</h2>
<ul class="lp-list"><li><a href="/blog/dds-registraciya">Регистрация по ДДС през 2026 г.: прагът от 51 130 € и новите срокове</a></li><li><a href="/blog/7-schetovodni-greshki">7 счетоводни грешки, които виждаме най-често при нови фирми</a></li></ul>
</div></section>
<section class="lp-cta"><div class="lp-wrap">
<h2>Близо ли сте до прага за ДДС?</h2>
<p>Пишете ни – ще ви отговорим с конкретна оферта. Офис в София, жк. Дървеница, работим и дистанционно.</p>
<div class="lp-actions"><a class="lp-btn lp-btn--main" href="tel:+359879884488">Обадете се: 0879 88 44 88</a><a class="lp-btn lp-btn--ghost" href="/bg/contact#contact-form">Поискайте безплатна оферта</a></div>
</div></section>
</main> 
<!-- ===== FOOTER (VAMIBEX 18.10.2026) ===== -->
<!-- www -> non-www (VAMIBEX 12.11.2026; временно, докато няма 301 на сървъра) -->
</Layout>
