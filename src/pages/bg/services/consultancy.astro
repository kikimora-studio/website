---
import Layout from '../../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://mehovconsult.com/bg/services/consultancy",
      "name": "Данъчен консултант в София – консултации | Мехов Консулт",
      "description": "Данъчни и счетоводни консултации за фирми в София – ДДС, данъци, отчетност и финансови решения. Над 25 години опит. Мехов Консулт.",
      "url": "https://mehovconsult.com/bg/services/consultancy",
      "inLanguage": "bg",
      "isPartOf": {
        "@type": "WebSite",
        "name": "Мехов Консулт",
        "url": "https://mehovconsult.com/bg"
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://mehovconsult.com/bg/services/consultancy#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Колко струва консултацията?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "От 50 € на час. Точната сума зависи от вида и обема на въпроса. Свържете се с нас, за да обсъдим конкретния ви случай и да получите оферта."
          }
        },
        {
          "@type": "Question",
          "name": "Мога ли да ползвам консултация, без да съм ваш счетоводен клиент?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да. Консултантските услуги са напълно отделни — не е нужно да сменяте настоящия си счетоводител, за да получите компетентно мнение от нас."
          }
        },
        {
          "@type": "Question",
          "name": "ЕТ или ЕООД — коя форма е по-подходяща за мен?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Зависи от вида дейност и нивото на риск. При ЕООД личното ви имущество е защитено, при ЕТ отговаряте с цялото си имущество. Свържете се с нас за конкретна преценка."
          }
        },
        {
          "@type": "Question",
          "name": "Работите ли с клиенти извън София?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да. Консултациите могат да се провеждат и дистанционно."
          }
        }
      ]
    }
  ]
};
---
<Layout lang="bg" path="/bg/services/consultancy" title={"Данъчен консултант в София – консултации | Мехов Консулт"} description={"Данъчни и счетоводни консултации за фирми в София – ДДС, данъци, отчетност и финансови решения. Над 25 години опит. Мехов Консулт."} schema={schema}>
<main class="mc-service">
  <style is:inline>
    .mc-service {
      --brand: #d00000;
      --brand-2: #4d0000;
      --red: #d00000;
      --red-dark: #b91c1c;
      --text: #15181b;
      --muted: #5b6672;
      --surface: #ffffff;
      --bg: #fefefe;
      --border: rgba(0, 0, 0, 0.06);
      --radius: 20px;
      --shadow: 0 20px 60px rgba(0, 0, 0, 0.10);
      --shadow-soft: 0 12px 30px rgba(0, 0, 0, 0.07);
      font-family: "PT Sans", system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
      color: var(--text);
      background: var(--bg);
      line-height: 1.6;
      max-width: 100%;
    }
    .mc-service * { box-sizing: border-box; }
    .mc-service .container {
      width: 100%;
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 20px;
    }
    .mc-service .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 14px 28px;
      border-radius: 999px;
      font-weight: 700;
      font-size: 0.95rem;
      text-decoration: none;
      border: none;
      cursor: pointer;
      font-family: inherit;
      transition: transform 0.3s ease, box-shadow 0.3s ease, background 0.3s ease, color 0.3s ease;
    }
    .mc-service .btn-orange {
      background: var(--brand);
      color: #fff;
      box-shadow: 0 15px 40px rgba(208, 0, 0, 0.3);
    }
    .mc-service .btn-orange:hover { transform: translateY(-3px); background: var(--red-dark); }
    .mc-service .btn-outline {
      background: #fff;
      color: var(--red);
      border: 2px solid var(--red);
    }
    .mc-service .btn-outline:hover { background: var(--red); color: #fff; }
    /* HERO — семпъл градиент, без снимка */
    .mc-service .svc-hero {
      position: relative;
      padding: 96px 20px 72px;
      text-align: center;
      overflow: hidden;
      background:
        radial-gradient(circle at 15% 20%, rgba(208, 0, 0, 0.10), transparent 45%),
        radial-gradient(circle at 85% 75%, rgba(208, 0, 0, 0.06), transparent 42%),
        linear-gradient(120deg, #ffffff, #fdf2f2);
    }
    .mc-service .svc-hero__wrap {
      position: relative;
      z-index: 1;
      max-width: 720px;
      margin: 0 auto;
      animation: svcFadeUp 0.8s ease-out both;
    }
    @keyframes svcFadeUp {
      from { opacity: 0; transform: translateY(26px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .mc-service .svc-hero__eyebrow {
      display: inline-block;
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--red);
      background: rgba(208, 0, 0, 0.08);
      padding: 6px 16px;
      border-radius: 999px;
      margin-bottom: 20px;
    }
    .mc-service .svc-hero__title {
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 800;
      color: var(--red);
      margin: 0 0 16px;
      line-height: 1.15;
    }
    .mc-service .svc-hero__sub {
      font-size: clamp(1.05rem, 2.2vw, 1.2rem);
      color: var(--muted);
      margin: 0 auto 30px;
      max-width: 620px;
    }
    .mc-service .svc-hero__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      justify-content: center;
    }
    /* INTRO */
    .mc-service .svc-intro {
      padding: 64px 0 24px;
    }
    .mc-service .svc-intro__inner {
      max-width: 800px;
      margin: 0 auto;
      text-align: center;
    }
    .mc-service .svc-intro h2 {
      font-size: clamp(1.6rem, 3.5vw, 2.1rem);
      color: var(--brand-2);
      font-weight: 800;
      margin: 0 0 18px;
    }
    .mc-service .svc-intro p {
      font-size: 1.08rem;
      color: var(--muted);
      margin: 0 0 16px;
    }
    /* INCLUDES — grid of what's covered */
    .mc-service .svc-includes {
      padding: 48px 0 56px;
    }
    .mc-service .svc-includes h2 {
      text-align: center;
      font-size: clamp(1.5rem, 3.5vw, 2rem);
      color: var(--brand-2);
      font-weight: 800;
      margin: 0 0 36px;
    }
    .mc-service .svc-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 20px;
    }
    @media (min-width: 720px) {
      .mc-service .svc-grid { grid-template-columns: repeat(2, 1fr); }
    }
    .mc-service .svc-card {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 26px 24px;
      box-shadow: var(--shadow-soft);
      transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
      display: flex;
      gap: 16px;
      align-items: flex-start;
    }
    .mc-service .svc-card:hover {
      transform: translateY(-5px);
      box-shadow: var(--shadow);
      border-color: rgba(208, 0, 0, 0.15);
    }
    .mc-service .svc-card__icon {
      flex-shrink: 0;
      width: 46px;
      height: 46px;
      border-radius: 12px;
      background: rgba(208, 0, 0, 0.08);
      color: var(--red);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .mc-service .svc-card__icon svg { width: 24px; height: 24px; }
    .mc-service .svc-card h3 {
      margin: 0 0 6px;
      font-size: 1.08rem;
      font-weight: 700;
      color: var(--text);
    }
    .mc-service .svc-card p {
      margin: 0;
      font-size: 0.96rem;
      color: var(--muted);
      line-height: 1.55;
    }
    /* WHY */
    .mc-service .svc-why {
      padding: 56px 0;
      background: #f9fafb;
    }
    .mc-service .svc-why__inner {
      max-width: 820px;
      margin: 0 auto;
      text-align: center;
    }
    .mc-service .svc-why h2 {
      font-size: clamp(1.5rem, 3.5vw, 2rem);
      color: var(--brand-2);
      font-weight: 800;
      margin: 0 0 18px;
    }
    .mc-service .svc-why p {
      font-size: 1.08rem;
      color: var(--muted);
      margin: 0 0 16px;
    }
    /* FAQ */
    .mc-service .svc-faq {
      padding: 56px 0 64px;
    }
    .mc-service .svc-faq h2 {
      text-align: center;
      font-size: clamp(1.5rem, 3.5vw, 2rem);
      color: var(--brand-2);
      font-weight: 800;
      margin: 0 0 32px;
    }
    .mc-service .faq-item {
      max-width: 800px;
      margin: 0 auto 12px;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      overflow: hidden;
      background: #fff;
      box-shadow: var(--shadow-soft);
    }
    .mc-service .faq-question {
      width: 100%;
      padding: 18px 22px;
      border: 0;
      background: #fff;
      text-align: left;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      font-family: inherit;
      color: var(--text);
    }
    .mc-service .faq-question span {
      color: var(--red);
      font-size: 1.3rem;
      transition: transform 0.25s ease;
      flex-shrink: 0;
    }
    .mc-service .faq-answer {
      max-height: 0;
      overflow: hidden;
      background: #fafafa;
      padding: 0 22px;
      transition: all 0.4s ease;
      color: var(--muted);
      line-height: 1.7;
    }
    .mc-service .faq-item.active .faq-answer { max-height: 300px; padding: 0 22px 18px; }
    .mc-service .faq-item.active .faq-question span { transform: rotate(45deg); }
    /* CTA */
    .mc-service .svc-cta {
      padding: 0 20px 64px;
      text-align: center;
    }
    .mc-service .svc-cta__inner {
      max-width: 1100px;
      margin: 0 auto;
      padding: 52px 24px;
      border-radius: 24px;
      background: linear-gradient(120deg, rgba(208, 0, 0, 0.10), #fff);
      border: 1px solid rgba(208, 0, 0, 0.08);
    }
    .mc-service .svc-cta__inner h2 {
      font-size: clamp(1.7rem, 4vw, 2.3rem);
      color: var(--red);
      font-weight: 800;
      margin: 0 0 14px;
    }
    .mc-service .svc-cta__inner p {
      font-size: 1.1rem;
      color: var(--muted);
      max-width: 640px;
      margin: 0 auto 28px;
    }
    .mc-service .svc-cta__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      justify-content: center;
    }
    /* MODAL */
    .mc-service .modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.55);
      justify-content: center;
      align-items: flex-start;
      padding: 40px 20px;
      z-index: 99999;
      overflow-y: hidden;
      backdrop-filter: blur(4px);
    }
    .mc-service .modal.show { display: flex; overflow-y: auto; }
    .mc-service .modal-content {
      background: #fff;
      border-radius: 24px;
      padding: 32px;
      max-width: 640px;
      width: 100%;
      position: relative;
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.2);
    }
    .mc-service .modal-content h2 { color: var(--red-dark); margin: 0 0 10px; font-size: 1.5rem; }
    .mc-service .modal-content > p { margin: 0 0 16px; color: var(--muted); }
    .mc-service #closeModal {
      position: absolute;
      top: 14px;
      right: 18px;
      font-size: 28px;
      font-weight: 700;
      color: #111;
      cursor: pointer;
      background: none;
      border: 0;
      padding: 0;
      line-height: 1;
    }
    .mc-service #closeModal:hover { color: var(--red-dark); }
    .mc-service .modal-form {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      margin-top: 14px;
    }
    .mc-service .modal-form .field-full { grid-column: 1 / -1; }
    .mc-service .modal-form input,
    .mc-service .modal-form textarea {
      border: 1px solid #ddd;
      border-radius: 14px;
      padding: 14px 16px;
      width: 100%;
      font-size: 14px;
      font-family: inherit;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .mc-service .modal-form textarea { min-height: 110px; resize: vertical; }
    .mc-service .modal-form input:focus,
    .mc-service .modal-form textarea:focus {
      outline: none;
      border-color: var(--red);
      box-shadow: 0 0 0 4px rgba(208, 0, 0, 0.12);
    }
    .mc-service .modal-form .form-verify-block {
      grid-column: 1 / -1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.25rem;
    }
    .mc-service .modal-form .turnstile-modal-widget-wrap {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .mc-service .modal-form .form-security-loading {
      display: flex;
      align-items: center;
      gap: 0.375rem;
      color: #9ca3af;
      font-size: 0.8rem;
    }
    .mc-service .modal-form .form-security-spinner {
      width: 0.875rem;
      height: 0.875rem;
      border: 2px solid #e5e7eb;
      border-top-color: var(--red);
      border-radius: 50%;
      animation: svcSpin 0.7s linear infinite;
    }
    @keyframes svcSpin { to { transform: rotate(360deg); } }
    .mc-service .modal-form .turnstile-modal-widget { display: flex; justify-content: center; width: 100%; }
    .mc-service .modal-form .turnstile-modal-status { font-size: 0.8rem; text-align: center; color: #6b7280; }
    .mc-service .modal-form [data-form-result] { grid-column: 1 / -1; min-height: 1.25rem; font-size: 0.95rem; }
    .mc-service .modal-form button[type="submit"] {
      grid-column: 1 / -1;
      background: var(--red-dark);
      color: #fff;
      padding: 14px 24px;
      border-radius: 40px;
      font-weight: 600;
      cursor: pointer;
      border: 0;
      font-family: inherit;
      font-size: 1rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }
    .mc-service .modal-form button[type="submit"]:hover:not(:disabled) { background: #991b1b; }
    .mc-service .modal-form button[type="submit"]:disabled { background: #9ca3af; cursor: not-allowed; }
    .mc-service .reveal { opacity: 0; transform: translateY(24px); transition: opacity 0.7s ease, transform 0.7s ease; }
    .mc-service .reveal.is-visible { opacity: 1; transform: translateY(0); }
    @media (max-width: 600px) {
      .mc-service .svc-hero { padding: 76px 16px 56px; }
      .mc-service .svc-hero__actions,
      .mc-service .svc-cta__actions { flex-direction: column; align-items: center; }
      .mc-service .svc-hero__actions .btn,
      .mc-service .svc-cta__actions .btn { width: 100%; max-width: 320px; }
      .mc-service .modal-form { grid-template-columns: 1fr; }
      .mc-service .svc-card { flex-direction: column; }
    }
  </style>
  <section class="svc-hero">
    <div class="svc-hero__wrap">
      <span class="svc-hero__eyebrow">Консултантски услуги</span>
      <h1 class="svc-hero__title">Данъчни консултации в София</h1>
      <p class="svc-hero__sub">Конкретни отговори на конкретните ви въпроси — данъчно планиране и стратегически съвети за оптимизация на разходите и уверен растеж.</p>
      <div class="svc-hero__actions">
        <a href="tel:+359879884488" class="btn btn-orange">Обадете се: 0879 88 44 88</a>
        <a href="/bg/contact#contact-form" class="btn btn-outline" data-open-enquiry=""><i class="fa-solid fa-paper-plane"></i> Заявете консултация</a>
      </div>
<!-- mc-hero-call (VAMIBEX 20.10.2026) -->
<p class="mc-hero-call" style="margin: 14px 0 0; font-size: 0.95rem; line-height: 1.5; opacity: 0.92; max-width: 640px;">Свържете се с Дойчин Мехов. Разкажете накратко какво ви трябва – той ще ви каже следващите стъпки и ще получите оферта.</p>
<!-- mc-hero-price (VAMIBEX 20.10.2026) -->
<p class="mc-hero-price" style="margin: 10px 0 0; font-size: 1rem; line-height: 1.5; font-weight: 700; max-width: 640px;">Консултация – от 50 € на час</p>
    </div>
  </section>
  <section class="svc-intro reveal">
    <div class="container">
      <div class="svc-intro__inner">
        <h2>Когато ви трябва конкретен отговор</h2>
        <p>Понякога не ви трябва месечно счетоводство, а ясен отговор на конкретен въпрос — как да оптимизирате данъчното си облагане, дали да минете от ЕТ към ЕООД, как да структурирате нова сделка. Точно затова предлагаме консултантски услуги отделно от текущото счетоводно обслужване.</p>
        <p>Работим както с клиенти, които вече ползват счетоводните ни услуги, така и с фирми, които просто търсят компетентно мнение отвън, без да сменят настоящия си счетоводител.</p>
      </div>
    </div>
  </section>
  <section class="svc-includes reveal">
    <div class="container">
      <h2>С какво можем да помогнем</h2>
      <div class="svc-grid">
        <div class="svc-card">
          <div class="svc-card__icon"><svg viewBox="0 0 24 24" fill="none"><path d="M3 17l6-6 4 4 7-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path><path d="M17 8h4v4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg></div>
          <div><h3>Данъчно планиране и оптимизация</h3><p>Законни стратегии за намаляване на данъчната тежест, съобразени с конкретната ви дейност.</p></div>
        </div>
        <div class="svc-card">
          <div class="svc-card__icon"><svg viewBox="0 0 24 24" fill="none"><rect x="4" y="3" width="16" height="18" rx="2" stroke="currentColor" stroke-width="1.8"></rect><path d="M8 8h8M8 12h8M8 16h5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg></div>
          <div><h3>Избор на правна форма</h3><p>Помощ при избора между ЕТ, ЕООД, ООД — при стартиране или преструктуриране на бизнес.</p></div>
        </div>
        <div class="svc-card">
          <div class="svc-card__icon"><svg viewBox="0 0 24 24" fill="none"><path d="M12 2v20M5 8l7-4 7 4M5 8v8l7 4 7-4V8" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path></svg></div>
          <div><h3>Консултации при сделки и инвестиции</h3><p>Експертен поглед при сделки, инвестиции или разширяване на дейността.</p></div>
        </div>
        <div class="svc-card">
          <div class="svc-card__icon"><svg viewBox="0 0 24 24" fill="none"><path d="M12 3l8 4v5c0 5-3.5 7.5-8 9-4.5-1.5-8-4-8-9V7l8-4z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg></div>
          <div><h3>Помощ при данъчни проверки</h3><p>Подготовка и съдействие при данъчни проверки и комуникация с НАП.</p></div>
        </div>
        <div class="svc-card">
          <div class="svc-card__icon"><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"></circle><path d="M12 8v4l3 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg></div>
          <div><h3>Еднократни или регулярни консултации</h3><p>Според нуждите ви — от еднократен въпрос до постоянна консултантска подкрепа.</p></div>
        </div>
        <div class="svc-card">
          <div class="svc-card__icon"><svg viewBox="0 0 24 24" fill="none"><path d="M4 19V5M4 19h16M8 15l3-3 3 2 4-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg></div>
          <div><h3>Стратегия за растеж</h3><p>Финансови насоки за устойчиво развитие в динамична и конкурентна бизнес среда.</p></div>
        </div>
      </div>
    </div>
  </section>
  <section class="svc-why reveal">
    <div class="container">
      <div class="svc-why__inner">
        <h2>Защо да се доверите на нас</h2>
