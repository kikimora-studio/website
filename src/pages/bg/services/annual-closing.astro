---
import Layout from '../../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://mehovconsult.com/bg/services/annual-closing",
      "url": "https://mehovconsult.com/bg/services/annual-closing",
      "name": "Годишно приключване и ГФО за фирми | Мехов Консулт",
      "description": "Годишно приключване за ЕООД, ООД и ЕТ: годишен финансов отчет, данъчна декларация по ЗКПО или ЗДДФЛ, публикуване в Търговския регистър и отчет към НСИ.",
      "inLanguage": "bg",
      "isPartOf": {
        "@type": "WebSite",
        "name": "Мехов Консулт",
        "url": "https://mehovconsult.com/bg"
      },
      "about": {
        "@id": "https://mehovconsult.com/#organization"
      }
    },
    {
      "@type": "Service",
      "name": "Годишно приключване на фирма в София",
      "serviceType": "Годишно приключване",
      "areaServed": [
        {
          "@type": "City",
          "name": "София"
        },
        {
          "@type": "Country",
          "name": "България"
        }
      ],
      "provider": {
        "@id": "https://mehovconsult.com/#organization"
      },
      "url": "https://mehovconsult.com/bg/services/annual-closing"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "До кога се подава годишната декларация на ЕООД през 2026 г.?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "До 30 юни 2026 г. за 2025 г. В същия срок се плаща корпоративният данък. Годишният финансов отчет се публикува в Търговския регистър до 30 септември 2026 г."
          }
        },
        {
          "@type": "Question",
          "name": "Подава ли се декларация, ако фирмата е на загуба?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да. Декларация се подава и при загуба. Данъчната загуба може да се приспада от печалбата през следващите 5 години."
          }
        },
        {
          "@type": "Question",
          "name": "Какво подава фирма, която не е имала дейност?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ако през годината не е имало никакво движение, се подава декларация за липса на дейност в Търговския регистър – до 30 юни. Ако е имало дори една операция, се прави пълно приключване."
          }
        },
        {
          "@type": "Question",
          "name": "Приключвате ли фирми, които не са ваши месечни клиенти?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Пишете ни – ще прегледаме документите и ще ви кажем дали и как може да стане."
          }
        }
      ]
    }
  ]
};
---
<Layout lang="bg" path="/bg/services/annual-closing" title={"Годишно приключване и ГФО за фирми | Мехов Консулт"} description={"Годишно приключване за ЕООД, ООД и ЕТ: годишен финансов отчет, данъчна декларация по ЗКПО или ЗДДФЛ, публикуване в Търговския регистър и отчет към НСИ."} schema={schema}>
<style is:inline>
/* landing pages (VAMIBEX 19.10.2026) */
.mc-landing { color: #1f2937; line-height: 1.7; }
.mc-landing .lp-hero { background: #111827; color: #fff; padding: 64px 20px 56px; }
.mc-landing .lp-wrap { max-width: 980px; margin: 0 auto; }
.mc-landing .lp-hero h1 { font-size: 2.3rem; line-height: 1.2; margin: 0 0 16px; color: #fff; }
.mc-landing .lp-hero p { font-size: 1.1rem; color: #e5e7eb; margin: 0 0 24px; max-width: 760px; }
.mc-landing .lp-actions { display: flex; flex-wrap: wrap; gap: 12px; }
.mc-landing .lp-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 24px; border-radius: 10px; font-weight: 700; text-decoration: none; }
.mc-landing .lp-btn--main { background: #d00000; color: #fff; }
.mc-landing .lp-btn--ghost { border: 2px solid #fff; color: #fff; }
.mc-landing .lp-trust { list-style: none; display: flex; flex-wrap: wrap; gap: 8px 20px; padding: 0; margin: 18px 0 0; font-weight: 600; }
.mc-landing .lp-trust li::before { content: "✓"; margin-right: 6px; color: #22c55e; font-weight: 800; }
.mc-landing .lp-sec { padding: 48px 20px 8px; }
.mc-landing .lp-sec h2 { font-size: 1.6rem; margin: 0 0 16px; color: #111827; }
.mc-landing .lp-sec h3 { font-size: 1.1rem; margin: 22px 0 6px; color: #111827; }
.mc-landing .lp-list { padding-left: 22px; }
.mc-landing .lp-list li { margin: 0 0 8px; }
.mc-landing .lp-steps { counter-reset: s; list-style: none; padding: 0; display: grid; gap: 14px; }
.mc-landing .lp-steps li { counter-increment: s; position: relative; padding: 14px 16px 14px 60px; background: #f9fafb; border-radius: 12px; }
.mc-landing .lp-steps li::before { content: counter(s); position: absolute; left: 16px; top: 14px; width: 30px; height: 30px; border-radius: 50%; background: #d00000; color: #fff; font-weight: 800; display: flex; align-items: center; justify-content: center; }
.mc-landing .lp-related a { color: #d00000; }
.mc-landing .lp-cta { margin: 48px 20px 64px; padding: 32px 24px; background: #fef2f2; border-radius: 16px; text-align: center; }
.mc-landing .lp-cta h2 { margin: 0 0 10px; font-size: 1.5rem; color: #111827; }
.mc-landing .lp-cta p { margin: 0 0 18px; }
.mc-landing .lp-cta .lp-btn--ghost { border-color: #d00000; color: #d00000; }
.mc-landing .lp-cta .lp-actions { justify-content: center; }
@media (max-width: 600px) {
  .mc-landing .lp-hero { padding: 44px 16px 40px; }
  .mc-landing .lp-hero h1 { font-size: 1.8rem; }
  .mc-landing .lp-btn { width: 100%; }
}
</style>
<main class="mc-landing">
<section class="lp-hero"><div class="lp-wrap">
<h1>Годишно приключване на фирма в София</h1>
<p>Изготвяме годишния финансов отчет и данъчната декларация, публикуваме отчета в Търговския регистър и подаваме отчета към НСИ. Започваме преди края на годината, за да остане време за законно намаляване на данъка.</p>
<div class="lp-actions"><a class="lp-btn lp-btn--main" href="tel:+359879884488">Обадете се: 0879 88 44 88</a><a class="lp-btn lp-btn--ghost" href="/bg/contact#contact-form">Поискайте безплатна оферта</a></div>
<!-- mc-hero-call (VAMIBEX 20.10.2026) -->
<p class="mc-hero-call" style="margin: 14px 0 0; font-size: 0.95rem; line-height: 1.5; opacity: 0.92; max-width: 640px;">Свържете се с Дойчин Мехов. Разкажете накратко какво ви трябва – той ще ви каже следващите стъпки и ще получите оферта.</p>
<ul class="lp-trust"><li>Говорите директно с Дойчин Мехов</li><li>Офис в София, жк. Дървеница</li><li>Над 25 години опит</li></ul>
</div></section>
<section class="lp-sec"><div class="lp-wrap">
<h2>Какво включва годишното приключване</h2>
<ul class="lp-list"><li>Годишен финансов отчет – баланс, отчет за приходите и разходите и приложения</li><li>Годишна данъчна декларация по чл. 92 от ЗКПО за дружествата или по чл. 50 от ЗДДФЛ за ЕТ</li><li>Изчисляване на корпоративния данък (10%) или данъка за ЕТ (15%)</li><li>Публикуване на финансовия отчет в Търговския регистър</li><li>Годишен отчет към НСИ, когато фирмата има такова задължение</li><li>Декларация за липса на дейност за фирми без движение през годината</li></ul>
</div></section>
<section class="lp-sec"><div class="lp-wrap">
<h2>Как работим</h2>
<ol class="lp-steps"><li>Изпращате ни документите за годината – фактури, банкови извлечения, каса</li><li>Проверяваме за пропуски още преди 31 декември</li><li>Изготвяме отчета и декларацията и ви ги показваме</li><li>Подаваме в НАП, Търговския регистър и НСИ в срок</li></ol>
</div></section>
<section class="lp-sec lp-faq"><div class="lp-wrap">
<h2>Често задавани въпроси</h2>
<h3>До кога се подава годишната декларация на ЕООД през 2026 г.?</h3>
<p>До 30 юни 2026 г. за 2025 г. В същия срок се плаща корпоративният данък. Годишният финансов отчет се публикува в Търговския регистър до 30 септември 2026 г.</p>
<h3>Подава ли се декларация, ако фирмата е на загуба?</h3>
<p>Да. Декларация се подава и при загуба. Данъчната загуба може да се приспада от печалбата през следващите 5 години.</p>
<h3>Какво подава фирма, която не е имала дейност?</h3>
<p>Ако през годината не е имало никакво движение, се подава декларация за липса на дейност в Търговския регистър – до 30 юни. Ако е имало дори една операция, се прави пълно приключване.</p>
<h3>Приключвате ли фирми, които не са ваши месечни клиенти?</h3>
<p>Пишете ни – ще прегледаме документите и ще ви кажем дали и как може да стане.</p>
</div></section>
<section class="lp-sec lp-related"><div class="lp-wrap">
<h2>Полезно от блога</h2>
<ul class="lp-list"><li><a href="/blog/godishno-prikluchvane">Годишно приключване 2026: срокове, декларации и подготовка</a></li><li><a href="/blog/danachni-oblekcheniya-startirashti-firmi">Данъчни облекчения за фирми през 2026 г.</a></li><li><a href="/blog/7-schetovodni-greshki">7 счетоводни грешки при нови фирми</a></li></ul>
</div></section>
<section class="lp-cta"><div class="lp-wrap">
<h2>Наближава годишното приключване?</h2>
<p>Пишете ни – ще ви отговорим с конкретна оферта. Офис в София, жк. Дървеница, работим и дистанционно.</p>
<div class="lp-actions"><a class="lp-btn lp-btn--main" href="tel:+359879884488">Обадете се: 0879 88 44 88</a><a class="lp-btn lp-btn--ghost" href="/bg/contact#contact-form">Поискайте безплатна оферта</a></div>
</div></section>
</main> 
<!-- ===== FOOTER (VAMIBEX 18.10.2026) ===== -->
<!-- www -> non-www (VAMIBEX 12.11.2026; временно, докато няма 301 на сървъра) -->
</Layout>
