      "url": "https://mehovconsult.com/bg/services/payroll"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Кога трябва да се уведоми НАП за нов трудов договор?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "В 3-дневен срок от сключването на договора и преди служителят да започне работа. Без уведомление служителят не може да бъде допуснат до работа."
          }
        },
        {
          "@type": "Question",
          "name": "До кога се подават декларациите за осигуровките?",
