---
import Layout from '../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://mehovconsult.com/bg/about",
      "name": "За нас – счетоводна кантора Мехов Консулт, София",
      "description": "Мехов Консулт е счетоводна кантора (счетоводна къща) в София, жк. Дървеница. Кои сме ние, как работим и защо фирмите ни се доверяват за счетоводство и данъци.",
      "url": "https://mehovconsult.com/bg/about",
      "inLanguage": "bg",
      "isPartOf": {
        "@type": "WebSite",
        "name": "Мехов Консулт",
        "url": "https://mehovconsult.com/bg"
      }
    }
  ]
};
---
<Layout lang="bg" path="/bg/about" title={"За нас – счетоводна кантора Мехов Консулт, София"} description={"Мехов Консулт е счетоводна кантора (счетоводна къща) в София, жк. Дървеница. Кои сме ние, как работим и защо фирмите ни се доверяват за счетоводство и данъци."} schema={schema}>
<div class="widget-placeholder-wrap">
<main class="mc-about-page">
  <style is:inline>
    .mc-about-page {
      --red: #d00000;
      --brand: #c00000;
      --bg: #f5f7fa;
      --surface: #ffffff;
      --text: #1f2937;
      --muted: #6b7280;
      --shadow: 0 15px 40px rgba(0, 0, 0, 0.08);
      --shadow-soft: 0 8px 24px rgba(0, 0, 0, 0.06);
      --radius: 14px;
      font-family: "PT Sans", "Inter", system-ui, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.7;
      max-width: 100%;
    }
    .mc-about-page * { box-sizing: border-box; }
    .mc-about-page .container {
      width: min(1100px, 92%);
      margin: 0 auto;
    }
    .mc-about-page .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 14px 28px;
      border-radius: 999px;
      font-weight: 600;
      font-size: 0.95rem;
      text-decoration: none;
      border: none;
      cursor: pointer;
      font-family: inherit;
      transition: transform 0.35s ease, box-shadow 0.35s ease, background 0.35s ease, color 0.35s ease;
    }
    .mc-about-page .btn-primary {
      background: var(--red);
      color: #fff;
      box-shadow: 0 15px 40px rgba(208, 0, 0, 0.25);
    }
    .mc-about-page .btn-primary:hover { transform: translateY(-3px); }
    .mc-about-page .btn-outline {
      background: #fff;
      color: var(--red);
      border: 2px solid var(--red);
    }
    .mc-about-page .btn-outline:hover {
      background: var(--red);
      color: #fff;
    }
    /* Hero */
    .mc-about-page .mc-about-hero {
      position: relative;
      padding: 88px 20px 64px;
      overflow: hidden;
      background:
        radial-gradient(circle at 12% 18%, rgba(208, 0, 0, 0.09), transparent 45%),
        radial-gradient(circle at 88% 80%, rgba(208, 0, 0, 0.05), transparent 40%),
        linear-gradient(120deg, #ffffff, #fdf2e9);
    }
    .mc-about-page .mc-about-hero__orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(60px);
      pointer-events: none;
      animation: mcAboutOrb 14s ease-in-out infinite alternate;
    }
    .mc-about-page .mc-about-hero__orb--1 {
      width: 260px;
      height: 260px;
      background: rgba(208, 0, 0, 0.1);
      top: -50px;
      left: -50px;
    }
    .mc-about-page .mc-about-hero__orb--2 {
      width: 200px;
      height: 200px;
      background: rgba(255, 200, 150, 0.35);
      bottom: -20px;
      right: 10%;
      animation-delay: -5s;
    }
    @keyframes mcAboutOrb {
      from { transform: translate(0, 0); }
      to { transform: translate(16px, 20px) scale(1.06); }
    }
    .mc-about-page .mc-about-hero__wrap {
      position: relative;
      z-index: 1;
      max-width: 720px;
      margin: 0 auto;
      text-align: center;
      animation: mcAboutFadeUp 0.85s ease-out both;
    }
    @keyframes mcAboutFadeUp {
      from { opacity: 0; transform: translateY(28px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .mc-about-page .mc-about-hero__title {
      font-size: clamp(2.2rem, 5vw, 3.4rem) !important;
      color: #d00000 !important;
      font-weight: 800 !important;
      margin: 0 0 16px !important;
      line-height: 1.12 !important;
    }
    .mc-about-page .mc-about-hero__sub {
      font-size: clamp(1.05rem, 2.2vw, 1.2rem) !important;
      color: #555555 !important;
      margin: 0 auto 32px !important;
      max-width: 560px;
    }
    .mc-about-page .mc-about-hero__actions {
      display: flex !important;
      flex-direction: row !important;
      flex-wrap: wrap;
      gap: 16px;
      justify-content: center !important;
      align-items: center !important;
    }
    /* About story — value cards */
    .mc-about-page .mc-about-story {
      padding: 48px 0 56px;
      background: linear-gradient(180deg, #fff 0%, #f8fafc 100%);
    }
    .mc-about-page .story-header {
      text-align: center;
      max-width: 760px;
      margin: 0 auto 36px;
    }
    .mc-about-page .story-header h2 {
      font-size: clamp(1.75rem, 4vw, 2.25rem);
      color: var(--red);
      margin: 0 0 12px;
      font-weight: 800;
    }
    .mc-about-page .story-lead {
      margin: 0 0 16px;
      font-size: 1.1rem;
      color: var(--muted);
      line-height: 1.65;
    }
    .mc-about-page .story-lead:last-child { margin-bottom: 0; }
    .mc-about-page .value-cards {
      display: grid;
      grid-template-columns: 1fr;
      gap: 20px;
      margin-bottom: 28px;
    }
    @media (min-width: 768px) {
      .mc-about-page .value-cards { grid-template-columns: repeat(2, 1fr); }
    }
    .mc-about-page .value-card {
      background: #fff;
      border: 1px solid rgba(0, 0, 0, 0.06);
      border-radius: 18px;
      padding: 28px 26px;
      box-shadow: var(--shadow-soft);
      transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;
      position: relative;
      overflow: hidden;
    }
    .mc-about-page .value-card::before {
      content: "";
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 4px;
      background: var(--red);
      transform: scaleY(0);
      transform-origin: top;
      transition: transform 0.35s ease;
    }
    .mc-about-page .value-card:hover {
      transform: translateY(-6px);
      box-shadow: var(--shadow);
      border-color: rgba(208, 0, 0, 0.15);
    }
    .mc-about-page .value-card:hover::before { transform: scaleY(1); }
    .mc-about-page .value-card__icon {
      width: 52px;
      height: 52px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(208, 0, 0, 0.08);
      color: var(--red);
      font-size: 1.25rem;
      margin-bottom: 16px;
      transition: background 0.3s ease, color 0.3s ease, transform 0.3s ease;
    }
    .mc-about-page .value-card:hover .value-card__icon {
      background: var(--red);
      color: #fff;
      transform: scale(1.05);
    }
    .mc-about-page .value-card h3 {
      margin: 0 0 10px;
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--text);
    }
    .mc-about-page .value-card p {
      margin: 0;
      font-size: 0.98rem;
      color: var(--muted);
      line-height: 1.6;
    }
    .mc-about-page .team-banner {
      display: flex;
      align-items: center;
      gap: 20px;
      padding: 28px 32px;
      border-radius: 20px;
      background: linear-gradient(120deg, rgba(208, 0, 0, 0.1), #fff);
      border: 1px solid rgba(208, 0, 0, 0.12);
      margin-bottom: 24px;
      transition: box-shadow 0.3s ease;
    }
    .mc-about-page .team-banner:hover {
      box-shadow: 0 12px 32px rgba(208, 0, 0, 0.1);
    }
    .mc-about-page .team-banner__icon {
      flex-shrink: 0;
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background: var(--red);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.35rem;
    }
    .mc-about-page .team-banner h3 {
      margin: 0 0 4px;
      font-size: 1.2rem;
      font-weight: 800;
      color: var(--red);
    }
    .mc-about-page .team-banner p {
      margin: 0;
      font-size: 0.95rem;
      color: var(--muted);
    }
    .mc-about-page .story-mission {
      text-align: center;
      max-width: 680px;
      margin: 0 auto;
      padding: 20px 24px;
      font-size: 1.05rem;
      font-weight: 600;
      color: var(--text);
      background: #fff;
      border-radius: 14px;
      border: 1px dashed rgba(208, 0, 0, 0.25);
    }
    .mc-about-page .reveal .value-card {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.55s ease, transform 0.55s ease, box-shadow 0.35s ease, border-color 0.35s ease;
    }
    .mc-about-page .reveal.is-visible .value-card {
      opacity: 1;
      transform: translateY(0);
    }
    .mc-about-page .reveal.is-visible .value-card:nth-child(1) { transition-delay: 0.05s; }
    .mc-about-page .reveal.is-visible .value-card:nth-child(2) { transition-delay: 0.12s; }
    .mc-about-page .reveal.is-visible .value-card:nth-child(3) { transition-delay: 0.19s; }
    .mc-about-page .reveal.is-visible .value-card:nth-child(4) { transition-delay: 0.26s; }
    .mc-about-page .reveal.is-visible .value-card:hover { transform: translateY(-6px); }
    /* Stats */
    .mc-about-page .mc-stats {
      padding: 48px 0;
      background: var(--surface);
    }
    .mc-about-page .mc-stats__grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 24px;
      text-align: center;
    }
    @media (min-width: 992px) {
      .mc-about-page .mc-stats__grid { grid-template-columns: repeat(4, 1fr); }
    }
    .mc-about-page .mc-stats__card {
      padding: 36px 24px;
      border-radius: 22px;
      background: #fff;
      box-shadow: var(--shadow-soft);
      border: 1px solid rgba(0, 0, 0, 0.04);
      transition: all 0.3s ease;
    }
    .mc-about-page .mc-stats__card:hover {
      transform: translateY(-6px);
      box-shadow: var(--shadow);
    }
    .mc-about-page .mc-stats__icon {
      width: 70px;
      height: 70px;
      margin: 0 auto 16px;
      border-radius: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(208, 0, 0, 0.08);
      color: #d00000 !important;
      transition: 0.3s ease;
    }
    .mc-about-page .mc-stats__icon svg { width: 30px; height: 30px; }
    .mc-about-page .mc-stats__card:hover .mc-stats__icon {
      background: #d00000;
      color: #fff !important;
    }
    .mc-about-page .mc-stats__num {
      display: block !important;
      font-size: 2rem !important;
      font-weight: 900 !important;
      color: #c00000 !important;
      margin: 0 0 8px !important;
    }
    .mc-about-page .mc-stats__num::after { content: "+"; }
    .mc-about-page .mc-stats__label {
      display: block !important;
      color: #6b7280 !important;
      margin: 0 !important;
      font-weight: 600;
      font-size: 0.95rem;
    }
    /* CTA */
    .mc-about-page .mc-about-cta {
      padding: 8px 20px 56px;
      text-align: center;
    }
    .mc-about-page .cta-inner {
      max-width: 1200px;
      margin: 0 auto;
      padding: 56px 24px;
      border-radius: 24px;
      background: linear-gradient(120deg, rgba(208, 0, 0, 0.1), #fff);
      border: 1px solid rgba(208, 0, 0, 0.08);
    }
    .mc-about-page .cta-inner h2 {
      font-size: clamp(1.8rem, 4vw, 2.5rem);
      color: var(--red);
      margin: 0 0 16px;
      font-weight: 800;
    }
    .mc-about-page .cta-inner p {
      font-size: 1.15rem;
      color: var(--muted);
      max-width: 700px;
      margin: 0 auto 30px;
    }
    .mc-about-page .cta-buttons {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 16px;
    }
    /* Modal */
    .mc-about-page .modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.55);
      justify-content: center;
      align-items: flex-start;
      padding: 40px 20px;
      z-index: 99999;
      overflow-y: hidden;
      backdrop-filter: blur(4px);
    }
    .mc-about-page .modal.show { display: flex; overflow-y: auto; }
    .mc-about-page .modal-content {
      background: #fff;
      border-radius: 24px;
      padding: 32px;
      max-width: 640px;
      width: 100%;
      position: relative;
      animation: mcAboutFadeUp 0.4s ease forwards;
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.2);
    }
    .mc-about-page .modal-content h2 {
      color: #b91c1c;
      margin: 0 0 10px;
      font-size: 1.5rem;
    }
    .mc-about-page .modal-content > p {
      margin: 0 0 16px;
      color: var(--muted);
    }
    .mc-about-page #closeModal {
      position: absolute;
      top: 14px;
      right: 18px;
      font-size: 28px;
      font-weight: 700;
      color: #111;
      cursor: pointer;
      background: none;
      border: 0;
      padding: 0;
      line-height: 1;
    }
    .mc-about-page #closeModal:hover { color: #b91c1c; }
    .mc-about-page .modal-form {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      margin-top: 14px;
    }
    .mc-about-page .modal-form .field-full { grid-column: 1 / -1; }
    .mc-about-page .modal-form input,
    .mc-about-page .modal-form textarea {
      border: 1px solid #ddd;
      border-radius: 14px;
      padding: 14px 16px;
      width: 100%;
      font-size: 14px;
      font-family: inherit;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .mc-about-page .modal-form textarea {
      min-height: 110px;
      resize: vertical;
    }
    .mc-about-page .modal-form input:focus,
    .mc-about-page .modal-form textarea:focus {
      outline: none;
      border-color: var(--red);
      box-shadow: 0 0 0 4px rgba(208, 0, 0, 0.12);
    }
    .mc-about-page .modal-form .form-verify-block {
      grid-column: 1 / -1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.25rem;
    }
    .mc-about-page .modal-form .turnstile-modal-widget-wrap {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .mc-about-page .modal-form .form-security-loading {
      display: flex;
      align-items: center;
      gap: 0.375rem;
      color: #9ca3af;
      font-size: 0.8rem;
    }
    .mc-about-page .modal-form .form-security-spinner {
      width: 0.875rem;
      height: 0.875rem;
      border: 2px solid #e5e7eb;
      border-top-color: var(--red);
      border-radius: 50%;
      animation: mcAboutSpin 0.7s linear infinite;
    }
    @keyframes mcAboutSpin { to { transform: rotate(360deg); } }
    .mc-about-page .modal-form .turnstile-modal-widget {
      display: flex;
      justify-content: center;
      width: 100%;
    }
    .mc-about-page .modal-form .turnstile-modal-status {
      font-size: 0.8rem;
      text-align: center;
      color: #6b7280;
    }
    .mc-about-page .modal-form [data-form-result] {
      grid-column: 1 / -1;
      min-height: 1.25rem;
      font-size: 0.95rem;
    }
    .mc-about-page .modal-form button[type="submit"] {
      grid-column: 1 / -1;
      background: #b91c1c;
      color: #fff;
      padding: 14px 24px;
      border-radius: 40px;
      font-weight: 600;
      cursor: pointer;
      border: 0;
      font-family: inherit;
      font-size: 1rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }
    .mc-about-page .modal-form button[type="submit"]:hover:not(:disabled) { background: #991b1b; }
    .mc-about-page .modal-form button[type="submit"]:disabled { background: #9ca3af; cursor: not-allowed; }
    .mc-about-page .reveal {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.7s ease, transform 0.7s ease;
    }
    .mc-about-page .reveal.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
    @media (max-width: 768px) {
      .mc-about-page .modal-form { grid-template-columns: 1fr; }
      .mc-about-page .mc-stats__grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 600px) {
      .mc-about-page .mc-about-hero { padding: 70px 16px 52px; }
      .mc-about-page .mc-about-hero__actions { flex-direction: column !important; }
      .mc-about-page .mc-about-hero__actions .btn,
      .mc-about-page .cta-buttons .btn { width: 100%; max-width: 320px; }
      .mc-about-page .team-banner { flex-direction: column; text-align: center; padding: 24px 20px; }
      .mc-about-page .mc-stats__grid { grid-template-columns: 1fr; }
      .mc-about-page .value-card { padding: 22px 20px; }
    }
</style>
  <section class="mc-about-hero">
    <div class="mc-about-hero__orb mc-about-hero__orb--1" aria-hidden="true"></div>
    <div class="mc-about-hero__orb mc-about-hero__orb--2" aria-hidden="true"></div>
    <div class="mc-about-hero__wrap">
      <h1 class="mc-about-hero__title">За Мехов Консулт</h1>
      <p class="mc-about-hero__sub">Счетоводна и консултантска кантора от 10 години, с над 25 години опит на Дойчин Мехов — до вас от първата регистрация до дългосрочния растеж на бизнеса ви.</p>
      <div class="mc-about-hero__actions">
        <a href="tel:+359879884488" class="btn btn-primary">Обадете се: 0879&nbsp;88&nbsp;44&nbsp;88</a>
        <a href="/bg/contact#contact-form" class="btn btn-outline" data-open-enquiry="">Свържете се с нас</a>
      </div>
<!-- mc-hero-call (VAMIBEX 22.10.2026) -->
<p class="mc-hero-call" style="margin: 14px auto 0; font-size: 0.95rem; line-height: 1.5; opacity: 0.92; max-width: 640px;">Свържете се с Дойчин Мехов. Разкажете накратко какво ви трябва – той ще ви каже следващите стъпки и ще получите оферта.</p>
    </div>
  </section>
<section class="mc-about-story reveal">
  <div class="container">
    <div class="story-header">
      <h2>Кои сме ние</h2>
      <p class="story-lead">Мехов Консулт е счетоводна и консултантска кантора, която работи от 10 години. Дойчин Мехов има над 25 години опит в счетоводството. Обслужваме малкия и среден бизнес – ЕООД, ООД, ЕТ и свободни професии – от регистрацията на фирмата до годишното приключване.</p>
      <p class="story-lead">Без значение дали тепърва регистрирате фирма, или търсите на кого да предадете месечното си счетоводство, ще говорите директно с Дойчин Мехов, човек, който познава материята — и говори на разбираем език, не само на счетоводен жаргон.</p>
    </div>
    <div class="value-cards">
      <article class="value-card">
        <div class="value-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" width="1em" height="1em">
            <path d="M12 3.5c1.6 2.4 3.2 5.2 3.2 8.2V15l-3.2 2.4L8.8 15v-3.3c0-3 1.6-5.8 3.2-8.2z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
            <path d="M8.8 13.2L6 15.2l1.6-3.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M15.2 13.2L18 15.2 16.4 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
            <circle cx="12" cy="10.2" r="1.3" fill="currentColor"></circle>
            <path d="M10.4 17.6c.4.9 1 1.4 1.6 1.8.6-.4 1.2-.9 1.6-1.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
          </svg>
        </div>
        <h3>Експертиза от първия ден</h3>
        <p>Стартирате или разширявате бизнеса си? Отговаряме на въпросите ви с яснота, прецизност и практични съвети, които можете да приложите веднага.</p>
      </article>
      <article class="value-card">
        <div class="value-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" width="1em" height="1em">
            <path d="M3.5 18.5H8V13h5V7.5H20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
            <circle cx="3.5" cy="18.5" r="1.5" fill="currentColor"></circle>
            <circle cx="8" cy="13" r="1.5" fill="currentColor"></circle>
            <circle cx="13" cy="7.5" r="1.5" fill="currentColor"></circle>
            <circle cx="20" cy="7.5" r="1.5" fill="currentColor"></circle>
          </svg>
