<script is:inline>
(function () {
  if ("IntersectionObserver" in window) {
    var revealIo = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) {
          e.target.classList.add("is-visible");
          revealIo.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll(".mc-about-page .reveal").forEach(function (el) { revealIo.observe(el); });
  } else {
    document.querySelectorAll(".mc-about-page .reveal").forEach(function (el) { el.classList.add("is-visible"); });
  }
  var statsSection = document.querySelector(".mc-about-page .mc-stats");
  if (statsSection && "IntersectionObserver" in window) {
    var counters = document.querySelectorAll(".mc-about-page .mc-stats__num");
    var statsDone = false;
    var cIo = new IntersectionObserver(function (entries) {
      if (!entries[0].isIntersecting || statsDone) return;
      statsDone = true;
      counters.forEach(function (counter) {
        var target = +counter.getAttribute("data-target");
        var step = Math.max(1, Math.ceil(target / 80));
        counter.textContent = "0";
        (function tick() {
          var cur = +counter.textContent;
          if (cur < target) {
            counter.textContent = String(Math.min(cur + step, target));
            window.setTimeout(tick, 20);
          }
        })();
      });
      cIo.disconnect();
    }, { threshold: 0.15 });
    cIo.observe(statsSection);
  }
})();
</script>
