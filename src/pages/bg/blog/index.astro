---
import Layout from '../../../layouts/Layout.astro';
import { getPosts, postPath, formatDate, isoDate } from '../../../lib/blog';

const posts = await getPosts();
const site = Astro.site!.origin;
const title = "Блог – счетоводни и данъчни статии | Мехов Консулт";
const description = "Практични статии от Мехов Консулт за регистрация на фирма, ДДС, осигуровки, годишно приключване и счетоводство за малки и средни фирми в София.";
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': site + '/bg/blog',
      url: site + '/bg/blog',
      name: title,
      description,
      inLanguage: 'bg',
      isPartOf: { '@type': 'WebSite', name: 'Мехов Консулт', url: site + '/bg' },
      about: { '@id': site + '/#organization' },
      mainEntity: {
        '@type': 'ItemList',
        itemListOrder: 'https://schema.org/ItemListOrderDescending',
        numberOfItems: posts.length,
        itemListElement: posts.map((post, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          url: site + postPath(post),
          name: post.data.seoTitle ?? post.data.title,
        })),
      },
    },
  ],
};
---
<Layout lang="bg" path="/bg/blog" title={title} description={description} schema={schema}>
<style is:inline>
.mc-blog{--red:#d00000;--red-dark:#b91c1c;--brand-2:#4d0000;--text:#15181b;--muted:#5b6672;--border:rgba(0,0,0,.08);--bg:#faf7f7;font-family:"PT Sans",system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;color:var(--text);background:#fff;line-height:1.65}
.mc-blog *{box-sizing:border-box}
.mc-blog a{color:var(--red);text-decoration:none}
.mc-blog a:hover{text-decoration:underline}
.mc-blog .wrap{width:100%;max-width:1080px;margin:0 auto;padding:0 20px}
.mc-blog .hero{padding:64px 20px 36px;background:radial-gradient(circle at 12% 18%,rgba(208,0,0,.09),transparent 42%),linear-gradient(180deg,#fff 0%,var(--bg) 100%);border-bottom:1px solid var(--border)}
.mc-blog .hero__inner{max-width:720px;margin:0 auto;text-align:center;animation:mcFade .7s ease-out both}
@keyframes mcFade{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}
.mc-blog .eyebrow{display:inline-block;font-size:.75rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--red);background:rgba(208,0,0,.08);padding:5px 12px;border-radius:999px;margin-bottom:14px}
.mc-blog h1{margin:0 0 12px;font-size:clamp(1.85rem,4vw,2.5rem);font-weight:800;color:var(--brand-2);letter-spacing:-.02em;line-height:1.2}
.mc-blog .lead{margin:0;font-size:1.1rem;color:var(--muted)}
.mc-blog .list{padding:40px 0 72px}
.mc-blog .grid{list-style:none;margin:0;padding:0;display:grid;gap:1.5rem}
@media(min-width:720px){.mc-blog .grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:1.75rem}}
.mc-blog .card{margin:0;height:100%}
.mc-blog .card__link{display:flex;flex-direction:column;height:100%;padding:1.35rem 1.4rem 1.5rem;border:1px solid var(--border);border-radius:16px;background:#fff;box-shadow:0 10px 28px rgba(0,0,0,.04);color:inherit;text-decoration:none;transition:transform .25s ease,box-shadow .25s ease,border-color .25s ease}
.mc-blog .card__link:hover{transform:translateY(-3px);box-shadow:0 16px 36px rgba(208,0,0,.1);border-color:rgba(208,0,0,.22);text-decoration:none}
.mc-blog .card__cat{margin:0 0 .45rem;font-size:.75rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--red)}
.mc-blog .card__title{margin:0 0 .55rem;font-size:1.2rem;font-weight:800;line-height:1.3;color:var(--brand-2)}
.mc-blog .card__link:hover .card__title{color:var(--red)}
.mc-blog .card__excerpt{margin:0 0 1rem;flex:1;font-size:.95rem;color:var(--muted);display:-webkit-box;-webkit-line-clamp:3;line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.mc-blog .card__meta{margin-top:auto;font-size:.875rem;color:var(--muted);font-weight:600}
.mc-blog .empty{padding:2rem;text-align:center;color:var(--muted);border:1px dashed var(--border);border-radius:12px}
.mc-blog .loading{padding:2rem;text-align:center;color:var(--muted)}
</style>

<main class="mc-blog" data-locale="bg">
  <section class="hero" aria-labelledby="mc-blog-title">
    <div class="hero__inner wrap">
      <span class="eyebrow">Блог · Мехов Консулт</span>
      <h1 id="mc-blog-title">Полезни статии за бизнеса</h1>
      <p class="lead">Счетоводство, регистрация на фирми и практически насоки за предприемачи в България.</p>
    </div>
  </section>

  <section class="list" aria-labelledby="mc-blog-list-title">
    <div class="wrap">
      <h2 id="mc-blog-list-title" class="visually-hidden" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)">Всички статии</h2>
      {posts.length > 0 ? (
        <ul class="grid" id="mc-blog-grid">
          {posts.map((post) => (
            <li class="card"><a class="card__link" href={postPath(post)}><p class="card__cat">Блог</p><h3 class="card__title">{post.data.seoTitle ?? post.data.title}</h3><p class="card__excerpt">{post.data.description}</p><div class="card__meta">Мехов Консулт · <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time></div></a></li>
          ))}
        </ul>
      ) : (
        <div id="mc-blog-empty" class="empty">Все още няма публикувани статии.</div>
      )}
    </div>
  </section>
</main>
</Layout>
