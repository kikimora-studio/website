---
// Shared CSS, in the cascade order the old site had it.
import '../styles/next-base.css';
import '../styles/tailwind-compat.css';
import '../styles/global.css';
import '../styles/header.css';
import '../styles/fixes.css';
import '../styles/footer.css';
import '../styles/privacy-note.css';
import '../styles/sticky-cta.css';
import '../styles/cookie-consent.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ui, PHONE_HREF, type Lang } from '../i18n/ui';
import { translationGroup } from '../data/routes';
import { organization } from '../data/organization';
import deploy from '../../deploy.config.mjs';

interface Props {
  lang: Lang;
  /** Canonical path of this page, without trailing slash, e.g. "/bg/about". */
  path: string;
  title: string;
  description: string;
  /** Title for social previews, when it should differ from <title>. */
  ogTitle?: string;
  /** Page-level JSON-LD (rendered next to the organization block). */
  schema?: object;
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

const { lang, path, title, description, ogTitle = title, schema, ogType = 'website', noindex = false } = Astro.props;
const t = ui[lang];
const site = Astro.site!.origin;
const canonical = site + path;
const image = site + '/images/hero.webp';

const group = translationGroup(path);
const alternates = group
  ? [...Object.entries(group), ['x-default', group.bg ?? path] as const].map(([hreflang, href]) => ({ hreflang, href: site + href }))
  : [];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>if(location.hostname==='www.mehovconsult.com')location.replace('https://mehovconsult.com'+location.pathname+location.search+location.hash);</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="icon" type="image/png" sizes="256x256" href="/images/favicon.png" />
    <link rel="apple-touch-icon" sizes="256x256" href="/images/favicon.png" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={t.siteName} />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1536" />
    <meta property="og:image:height" content="1024" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <script type="application/ld+json" set:html={JSON.stringify(organization[lang])} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <div data-lang={lang}>
      <Header lang={lang} path={path} />

      <slot />

      <Footer lang={lang} />

      <nav class="mc-sticky-cta" aria-label={t.sticky.label}>
        <a class="mc-sticky-cta__call" href={PHONE_HREF}>{t.sticky.call}</a>
        <a class="mc-sticky-cta__enq" href={t.sticky.enquiry.href} data-open-enquiry>{t.sticky.enquiry.label}</a>
      </nav>

      <div id="mc-cc" class="mc-cc" role="dialog" aria-live="polite" aria-label={t.cookie.label} data-settings={t.cookie.settings} hidden>
        <p>{t.cookie.text} <a href={t.cookie.privacy.href}>{t.cookie.privacy.label}</a></p>
        <div class="mc-cc__btns"><button type="button" class="mc-cc__no" data-cc="no">{t.cookie.decline}</button><button type="button" class="mc-cc__yes" data-cc="yes">{t.cookie.accept}</button></div>
      </div>
    </div>

    <script type="application/json" id="site-strings" set:html={JSON.stringify({ ...t.form, endpoint: deploy.formEndpoint })} />
    <script src="../scripts/site.js"></script>
  </body>
</html>
